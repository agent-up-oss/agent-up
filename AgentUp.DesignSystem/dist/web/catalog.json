{
  "surfaces": [
    {
      "id": "foundations",
      "title": "Foundations",
      "intro": "Black is the environment. Off-white carries hierarchy. Neutral gray creates structure. Green appears only for action, selection, progress, or health.",
      "components": [
        {
          "id": "canvas",
          "title": "Canvas",
          "note": "Root window, page, and PWA chrome use the canvas token.",
          "avalonia": "Window",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-theme",
          "classes": [
            "au-theme"
          ],
          "html": "<div class=\"au-theme\" style=\"min-height: 6rem; padding: 1.25rem;\">Quiet operational canvas.</div>"
        },
        {
          "id": "swatch",
          "title": "Color roles",
          "note": "Never introduce a raw product color when a semantic role exists.",
          "avalonia": "Border",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-swatch",
          "classes": [
            "au-cluster",
            "au-swatch"
          ],
          "html": "<div class=\"au-cluster\">\n        <span class=\"au-swatch\" style=\"background: var(--au-color-canvas)\" title=\"canvas\"></span>\n        <span class=\"au-swatch\" style=\"background: var(--au-color-surface)\" title=\"surface\"></span>\n        <span class=\"au-swatch\" style=\"background: var(--au-color-border-subtle)\" title=\"border\"></span>\n        <span class=\"au-swatch\" style=\"background: var(--au-color-text-primary)\" title=\"text\"></span>\n        <span class=\"au-swatch\" style=\"background: var(--au-color-accent)\" title=\"action\"></span>\n        <span class=\"au-swatch\" style=\"background: var(--au-color-status-healthy)\" title=\"healthy\"></span>\n        <span class=\"au-swatch\" style=\"background: var(--au-color-status-danger)\" title=\"danger\"></span>\n        <span class=\"au-swatch\" style=\"background: var(--au-color-focus)\" title=\"focus\"></span>\n      </div>"
        },
        {
          "id": "type",
          "title": "Typography",
          "note": "Applications use platform sans-serif at these roles. Authored web uses Inter.",
          "avalonia": "TextBlock",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-heading",
          "classes": [
            "au-eyebrow",
            "au-page-title",
            "au-heading",
            "au-muted",
            "au-mono"
          ],
          "html": "<p class=\"au-eyebrow\">AI-assisted development workspaces</p>\n      <h1 class=\"au-page-title\">Workspaces</h1>\n      <h2 class=\"au-heading\">See the runtime. Trust the review.</h2>\n      <p class=\"au-muted\">Product screens use page title, not the marketing display size. Monospace is reserved for commands, paths, ports, logs, and diffs.</p>\n      <code class=\"au-mono\">agentup start · localhost:11200 · feat/checkout</code>"
        }
      ]
    },
    {
      "id": "primitives",
      "title": "Primitives",
      "intro": "Shared controls compiled to web CSS, React Native style objects, and Avalonia styles. The HTML here is the structure Desktop infers.",
      "components": [
        {
          "id": "button",
          "title": "Buttons",
          "note": "Primary fill is the only bright green action. Danger is red, never green.",
          "avalonia": "Button",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-button",
          "classes": [
            "au-cluster",
            "au-button",
            "au-button--secondary",
            "au-button--danger",
            "au-button--compact"
          ],
          "html": "<div class=\"au-cluster\">\n        <button class=\"au-button\">Start workspace</button>\n        <button class=\"au-button au-button--secondary\">View diagnostics</button>\n        <button class=\"au-button au-button--danger\">Stop</button>\n        <button class=\"au-button au-button--compact\">Compact</button>\n      </div>"
        },
        {
          "id": "input",
          "title": "Field",
          "note": "Focus uses blue, not green, so keyboard state stays distinct from health.",
          "avalonia": "TextBox",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-input",
          "classes": [
            "au-stack",
            "au-field-label",
            "au-input"
          ],
          "html": "<label class=\"au-stack\"><span class=\"au-field-label\">Server URL</span><input class=\"au-input\" placeholder=\"https://agent-up.example.com\" /></label>"
        },
        {
          "id": "badge",
          "title": "Badges and status",
          "note": "Combine color with a label. Do not use a green dot alone.",
          "avalonia": "Border",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-badge",
          "classes": [
            "au-cluster",
            "au-badge",
            "au-badge--healthy",
            "au-status-dot",
            "au-status-dot--healthy",
            "au-badge--warning",
            "au-status-dot--warning",
            "au-badge--danger",
            "au-status-dot--danger",
            "au-badge--info",
            "au-status-dot--info"
          ],
          "html": "<div class=\"au-cluster\">\n        <span class=\"au-badge au-badge--healthy\"><span class=\"au-status-dot au-status-dot--healthy\"></span>Server online</span>\n        <span class=\"au-badge au-badge--warning\"><span class=\"au-status-dot au-status-dot--warning\"></span>Starting</span>\n        <span class=\"au-badge au-badge--danger\"><span class=\"au-status-dot au-status-dot--danger\"></span>Failed</span>\n        <span class=\"au-badge au-badge--info\"><span class=\"au-status-dot au-status-dot--info\"></span>MCP connected</span>\n      </div>"
        },
        {
          "id": "checkbox",
          "title": "Checkbox",
          "note": "Checked uses the selected fill. Do not outline idle boxes in accent green.",
          "avalonia": "Border",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-checkbox",
          "classes": [
            "au-cluster",
            "au-checkbox",
            "au-checkbox--checked"
          ],
          "html": "<div class=\"au-cluster\">\n        <span class=\"au-checkbox\"></span>\n        <span class=\"au-checkbox au-checkbox--checked\"></span>\n      </div>"
        },
        {
          "id": "card",
          "title": "Cards",
          "note": "Idle cards use a raised surface and a neutral border. Selected tints the fill; do not outline cards in accent green.",
          "avalonia": "Border",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-card",
          "classes": [
            "au-grid",
            "au-card",
            "au-muted",
            "au-card--selected",
            "au-card--danger"
          ],
          "html": "<div class=\"au-grid\">\n        <div class=\"au-card\"><strong>Idle surface</strong><p class=\"au-muted\">Neutral structure.</p></div>\n        <div class=\"au-card au-card--selected\"><strong>Selected</strong><p class=\"au-muted\">Green means this item is active.</p></div>\n        <div class=\"au-card au-card--danger\"><strong>Failed</strong><p class=\"au-muted\">Error cards never inherit accent borders.</p></div>\n      </div>"
        },
        {
          "id": "tabs",
          "title": "Tabs",
          "note": "Selected tabs use a brighter text and a muted underline, not a green fill.",
          "avalonia": "Button",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-tab",
          "classes": [
            "au-tabs",
            "au-tab",
            "au-tab--selected"
          ],
          "html": "<div class=\"au-tabs\" role=\"tablist\">\n        <button class=\"au-tab au-tab--selected\" aria-selected=\"true\">Browser</button>\n        <button class=\"au-tab\">Console</button>\n        <button class=\"au-tab\">Metrics</button>\n        <button class=\"au-tab\">Diagnostics</button>\n      </div>"
        },
        {
          "id": "callout",
          "title": "Callout",
          "note": "A left accent rule is enough. No glow.",
          "avalonia": "Border",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-callout",
          "classes": [
            "au-callout"
          ],
          "html": "<aside class=\"au-callout\"><strong>Browser ownership:</strong> Desktop WebViews and Server automation are separate sessions bound to the same workspace runtime.</aside>"
        },
        {
          "id": "code",
          "title": "Code surface",
          "note": "Code blocks use a neutral border. Do not force syntax into green.",
          "avalonia": "TextBlock",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-code",
          "classes": [
            "au-code"
          ],
          "html": "<pre class=\"au-code\">agentup start --worktree /srv/checkout-fix</pre>"
        }
      ]
    },
    {
      "id": "chrome",
      "title": "Desktop chrome",
      "intro": "Integrated title bar: sidebar, reload, Server badge, wordmark, then minimize, restore, close. The chrome is part of the product, not a host decoration.",
      "components": [
        {
          "id": "chrome",
          "title": "Title bar",
          "note": "Keep the mark small. Never add glow around the window.",
          "avalonia": "Border",
          "desktopClass": "",
          "desktopHost": "",
          "rootClass": "au-chrome",
          "classes": [
            "au-chrome",
            "au-cluster",
            "au-title-tool",
            "au-chrome-icon",
            "au-badge",
            "au-badge--healthy",
            "au-status-dot",
            "au-status-dot--healthy",
            "au-chrome-button",
            "au-chrome-close"
          ],
          "html": "<div class=\"au-chrome au-cluster\" style=\"justify-content: space-between; padding: 0 0.75rem;\">\n        <span class=\"au-cluster\">\n          <span class=\"au-title-tool au-chrome-icon\">☰</span>\n          <span class=\"au-title-tool au-chrome-icon\">↻</span>\n          <span class=\"au-badge au-badge--healthy\"><span class=\"au-status-dot au-status-dot--healthy\"></span>Server online</span>\n        </span>\n        <strong>Agent-Up</strong>\n        <span class=\"au-cluster\">\n          <span class=\"au-chrome-button au-chrome-icon\">−</span>\n          <span class=\"au-chrome-button au-chrome-icon\">□</span>\n          <span class=\"au-chrome-button au-chrome-close au-chrome-icon\">×</span>\n        </span>\n      </div>"
        },
        {
          "id": "chrome-button",
          "title": "Window controls",
          "note": "Close hover is danger red. Other chrome hover uses the selected tint.",
          "avalonia": "Border",
          "desktopClass": "chromeButton",
          "desktopHost": "Button",
          "rootClass": "au-chrome-button",
          "classes": [
            "au-cluster",
            "au-chrome-button",
            "au-chrome-icon",
            "au-chrome-close"
          ],
          "html": "<div class=\"au-cluster\">\n        <button class=\"au-chrome-button au-chrome-icon\">−</button>\n        <button class=\"au-chrome-button au-chrome-icon\">□</button>\n        <button class=\"au-chrome-button au-chrome-close au-chrome-icon\">×</button>\n      </div>"
        },
        {
          "id": "chrome-close",
