          "desktopClass": "wsEntry",
          "desktopHost": "ListBoxItem",
          "rootClass": "au-workspace",
          "classes": [
            "au-stack",
            "au-workspace",
            "au-workspace--selected",
            "au-lifecycle-button",
            "au-status-dot",
            "au-status-dot--healthy",
            "au-workspace-name",
            "au-workspace-branch",
            "au-workspace-delete",
            "au-status-dot--warning"
          ],
          "html": "<div class=\"au-stack\">\n        <div class=\"au-workspace au-workspace--selected\">\n          <button class=\"au-lifecycle-button\" type=\"button\">▶</button>\n          <span class=\"au-status-dot au-status-dot--healthy\"></span>\n          <span>\n            <strong class=\"au-workspace-name\">checkout-fix</strong>\n            <small class=\"au-workspace-branch\">feat/checkout</small>\n          </span>\n          <button class=\"au-workspace-delete\" type=\"button\">×</button>\n        </div>\n        <div class=\"au-workspace\">\n          <button class=\"au-lifecycle-button\" type=\"button\">▶</button>\n          <span class=\"au-status-dot au-status-dot--warning\"></span>\n          <span>\n            <strong class=\"au-workspace-name\">pricing</strong>\n            <small class=\"au-workspace-branch\">feat/pricing</small>\n          </span>\n          <button class=\"au-workspace-delete\" type=\"button\">×</button>\n        </div>\n        <div class=\"au-workspace\">\n          <button class=\"au-lifecycle-button\" type=\"button\">▶</button>\n          <span class=\"au-status-dot\"></span>\n          <span>\n            <strong class=\"au-workspace-name\">main</strong>\n            <small class=\"au-workspace-branch\">main</small>\n          </span>\n          <button class=\"au-workspace-delete\" type=\"button\">×</button>\n        </div>\n      </div>"
        },
        {
          "id": "workspace-name",
          "title": "Workspace name",
