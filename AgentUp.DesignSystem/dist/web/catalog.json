          "avalonia": "Border",
          "desktopClass": "titleToolButton",
          "desktopHost": "Button",
          "rootClass": "au-title-tool",
          "classes": [
            "au-cluster",
            "au-title-tool",
            "au-chrome-icon"
          ],
          "html": "<div class=\"au-cluster\">\n        <button class=\"au-title-tool au-chrome-icon\">☰</button>\n        <button class=\"au-title-tool au-chrome-icon\">↻</button>\n      </div>"
        }
      ]
    },
    {
      "id": "workspaces",
      "title": "Workspaces",
      "intro": "A workspace is the managed runtime and source identity. Do not name every row after an agent unless that is the display name.",
      "components": [
        {
