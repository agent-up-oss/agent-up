  <Style Selector="TextBlock.au-proof">
    <Setter Property="Background" Value="{DynamicResource AgentUpColorBorderSubtleBrush}"/>
  </Style>
  <Style Selector="TextBlock.au-logo-lockup">
    <Setter Property="Foreground" Value="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="{DynamicResource AgentUpWeightBlack}"/>
  </Style>
  <Style Selector="Border.au-logo-mark">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
  </Style>
  <Style Selector="TextBlock.au-logo-mark">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
  </Style>
  <Style Selector="TextBlock.au-do-dont">
    <Setter Property="FontWeight" Value="{DynamicResource AgentUpWeightBold}"/>
    <Setter Property="Foreground" Value="{DynamicResource AgentUpColorStatusDangerBrush}"/>
  </Style>
</Styles>
