<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentUp.Desktop.Features.Workspaces.ViewModels"
        xmlns:appVm="using:AgentUp.Desktop.Features.Applications.ViewModels"
        xmlns:portVm="using:AgentUp.Desktop.Features.Ports.ViewModels"
        xmlns:metricsVm="using:AgentUp.Desktop.Features.Metrics.ViewModels"
        xmlns:databaseVm="using:AgentUp.Desktop.Features.Ports.ViewModels"
        xmlns:databaseViewsVm="using:AgentUp.Desktop.Features.Database.ViewModels"
        xmlns:gitVm="using:AgentUp.Desktop.Features.Git.ViewModels"
        xmlns:validationVm="using:AgentUp.Desktop.Features.Validation.ViewModels"
        xmlns:metricsViews="using:AgentUp.Desktop.Features.Metrics.Views"
        xmlns:chromeVm="using:AgentUp.Desktop.Features.Workspaces.ViewModels.Chrome"
        x:Class="AgentUp.Desktop.Features.Workspaces.Views.MainWindow"
        x:CompileBindings="False"
        Width="1100" Height="700"
        MinWidth="640" MinHeight="400"
        Title="Agent-Up"
        WindowDecorations="None"
        Background="{DynamicResource AgentUpColorCanvasBrush}">

    <Window.DataTemplates>
        <!-- Console sub-tab -->
        <DataTemplate DataType="portVm:ConsoleSubTabViewModel">
            <Border Classes="subTab">
                <TextBlock Text="Console"
                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                           FontSize="12"
                           FontWeight="Bold"/>
            </Border>
        </DataTemplate>

        <!-- Database sub-tab -->
        <DataTemplate DataType="databaseVm:DatabaseSubTabViewModel">
            <Border Classes="subTab">
                <TextBlock Text="Database"
                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                           FontSize="12"
                           FontWeight="Bold"/>
            </Border>
        </DataTemplate>

        <!-- Metrics sub-tab -->
        <DataTemplate DataType="portVm:MetricsSubTabViewModel">
            <Border Classes="subTab">
                <TextBlock Text="Metrics"
                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                           FontSize="12"
                           FontWeight="Bold"/>
            </Border>
        </DataTemplate>

        <!-- Audit sub-tab -->
        <DataTemplate DataType="portVm:AuditSubTabViewModel">
            <Border Classes="subTab">
                <TextBlock Text="Diagnostics" Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}" FontSize="12" FontWeight="Bold"/>
            </Border>
        </DataTemplate>

        <!-- Metrics chart card -->
        <DataTemplate DataType="metricsVm:MetricsChartViewModel">
            <Border Classes="metricsChartCard" Margin="0,0,0,16">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding Unit}"
                                       Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LatestDisplay}"
                                   Foreground="{DynamicResource AgentUpColorStatusHealthyBrush}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <metricsViews:MetricsTimeSeriesChart Grid.Row="1"
                                                         Points="{Binding Points}"
                                                         Unit="{Binding Unit}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Metrics summary card -->
        <DataTemplate DataType="metricsVm:MetricsSummaryCardViewModel">
            <Border Classes="metricsSummaryCard">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Label}"
                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                               FontSize="11"
                               FontWeight="Medium"/>
                    <TextBlock Text="{Binding Value}"
                               Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                               FontSize="24"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Port sub-tab -->
        <DataTemplate DataType="portVm:PortSubTabViewModel">
            <Border Classes="subTab">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Border Width="6" Height="6"
                            CornerRadius="3"
                            Background="{Binding StatusColor}"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}"
                               Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="chromeVm:ChromeIconButtonViewModel">
            <Button Name="{Binding Name}"
                    Command="{Binding Command}"
                    ToolTip.Tip="{Binding ToolTip}">
                <Border Classes="titleToolButton">
                    <TextBlock Classes="chromeIcon"
                               Text="{Binding Icon}"
                               FontSize="{Binding FontSize}"/>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate DataType="chromeVm:ChromeServerStatusViewModel">
            <Border x:Name="ServerStatusBadge"
                    Margin="6,0,0,0"
                    Padding="12,5"
                    CornerRadius="999"
                    BorderBrush="{Binding ServerStatusColor}"
                    BorderThickness="1"
                    Background="{DynamicResource AgentUpColorSurfaceInputBrush}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="9"
                            Height="9"
                            CornerRadius="5"
                            Background="{Binding ServerStatusColor}"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServerStatusText"
                               Text="{Binding ServerStatusText}"
                               Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                               FontSize="11"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <!-- Fluent chrome that CSS cannot strip. Catalog classes keep generated AgentUpStyles. -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button:not(.au-button):not(.au-db-run):not(.dbRunButton):not(.wsDeleteButton):not(.au-workspace-delete)">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:not(.au-button):not(.au-db-run):not(.dbRunButton):not(.wsDeleteButton):not(.au-workspace-delete):pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button:not(.au-button):not(.au-db-run):not(.dbRunButton):not(.wsDeleteButton):not(.au-workspace-delete):pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Optical glyph alignment that CSS cannot express. -->
        <Style Selector="TextBlock.chromeIcon">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
        <Style Selector="TextBlock.chromeMinimizeIcon">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="LineHeight" Value="15"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
        <Style Selector="TextBlock.chromeRestoreIcon">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="14"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style Selector="TextBlock.chromeCloseIcon">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Margin" Value="0,-5,0,0"/>
        </Style>
        <Style Selector="TextBlock.wsLifecycleIcon">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.wsLifecycleIconPlay">
            <Setter Property="Margin" Value="1,0,0,0"/>
        </Style>
        <Style Selector="TextBlock.wsAddIcon">
            <Setter Property="Foreground" Value="{DynamicResource AgentUpColorAccentSoftBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.tutorialButtonText">
            <Setter Property="Foreground" Value="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AgentUpFontSizeXs}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.gitNodeName">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Avalonia-only caret and selection brushes. Visuals come from AgentUpStyles. -->
        <Style Selector="TextBox.addressBar">
            <Setter Property="CaretBrush" Value="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AgentUpColorBorderStrongBrush}"/>
        </Style>
        <Style Selector="TextBox.sqlEditor">
            <Setter Property="CaretBrush" Value="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AgentUpColorSurfaceSelectedStrongBrush}"/>
        </Style>
        <Style Selector="TextBox.dbCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AgentUpColorSurfaceSelectedStrongBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="{DynamicResource AgentUpFontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>
        <Style Selector="Border.dbHeaderCell">
            <Setter Property="BorderBrush" Value="{DynamicResource AgentUpColorBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="{DynamicResource AgentUpColorSurfaceRaisedBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="Border.dbDataCell">
            <Setter Property="BorderBrush" Value="{DynamicResource AgentUpColorBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="{DynamicResource AgentUpColorSurfaceBrush}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- ControlTemplates that HTML/CSS cannot emit. -->
        <Style Selector="ToggleButton.filterChip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="999"
                                Padding="13,7">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.filterChip:pointerover /template/ Border#ChipBorder">
            <Setter Property="Background" Value="{DynamicResource AgentUpColorSurfaceRaisedBrush}"/>
        </Style>
        <Style Selector="ToggleButton.filterChip:checked /template/ Border#ChipBorder">
            <Setter Property="Background" Value="{DynamicResource AgentUpColorSurfaceSelectedStrongBrush}"/>
        </Style>

        <Style Selector="ToggleButton.iosToggle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AgentUpColorBorderStrongBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                Width="40" Height="22">
                            <Border x:Name="Thumb"
                                    CornerRadius="9"
                                    Width="18" Height="18"
                                    Background="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.iosToggle:checked">
            <Setter Property="Background" Value="{DynamicResource AgentUpColorAccentBrightBrush}"/>
        </Style>
        <Style Selector="ToggleButton.iosToggle:checked /template/ Border#Thumb">
            <Setter Property="Margin" Value="20,0,0,0"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource AgentUpColorCanvasBrush}"
            BorderThickness="0">
    <Grid RowDefinitions="42,*">

        <Control x:Name="FocusSink"
                 Width="1"
                 Height="1"
                 Opacity="0"
                 Focusable="True"
                 IsHitTestVisible="False"/>

        <!-- Integrated window controls / drag surface -->
        <Border Grid.Row="0"
                x:Name="WindowChrome"
                Classes="au-chrome"
                PointerPressed="OnWindowChromePointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding Chrome.LeftItems}"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="avares://AgentUp.Desktop/media/logo.png"
                           Width="18"
                           Height="18"
                           Stretch="Uniform"/>
                    <TextBlock Text="Agent-Up"
                               Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="ValidationToggleButton"
                            Command="{Binding ToggleValidationCommand}"
                            ToolTip.Tip="Open validation checks">
                        <Border Classes="titleToolButton">
                            <TextBlock Classes="chromeIcon" Text="✓" FontSize="16"/>
                        </Border>
                    </Button>
                    <Button x:Name="MinimizeWindowButton"
                            Click="OnMinimizeWindowClicked"
                            ToolTip.Tip="Minimize">
                        <Border Classes="chromeButton">
                            <TextBlock Classes="chromeIcon chromeMinimizeIcon" Text="─"/>
                        </Border>
                    </Button>
                    <Button x:Name="RestoreWindowButton"
                            Click="OnRestoreWindowClicked"
                            ToolTip.Tip="Restore">
                        <Border Classes="chromeButton">
                            <TextBlock Classes="chromeIcon chromeRestoreIcon" Text="□"/>
                        </Border>
                    </Button>
                    <Button x:Name="CloseWindowButton"
                            Click="OnCloseWindowClicked"
                            ToolTip.Tip="Close">
                        <Border Classes="chromeButton chromeClose">
                            <TextBlock Classes="chromeIcon chromeCloseIcon" Text="×"/>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              x:Name="PageHost">
            <Panel x:Name="LoginPage"
                   IsVisible="{Binding Login.IsVisible}"
                   IsHitTestVisible="{Binding Login.IsVisible}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Background="{DynamicResource AgentUpColorCanvasBrush}">
                <Grid RowDefinitions="*,Auto,*"
                      ColumnDefinitions="*,Auto,*">
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Classes="au-sign-in"
                            Width="420">
                        <StackPanel Spacing="16">
                            <TextBlock Classes="au-eyebrow"
                                       Text="Agent-Up Server"/>
                            <TextBlock Classes="au-page-title"
                                       Text="Sign in"/>
                            <TextBlock Classes="au-muted"
                                       Text="Enter the administrator password to continue."
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding !Login.IsConnectionRetry}"/>
                            <TextBlock Classes="au-muted"
                                       Text="Could not reach the server. Check that Agent-Up Server is running and AGENTUP_SERVER_URL is correct."
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Login.IsConnectionRetry}"/>
                            <TextBlock Classes="au-field-label"
                                       Text="Admin password"
                                       IsVisible="{Binding !Login.IsConnectionRetry}"/>
                            <TextBox Classes="au-input"
                                     Text="{Binding Login.Password, Mode=TwoWay}"
                                     PasswordChar="●"
                                     PlaceholderText="Admin password"
                                     IsVisible="{Binding !Login.IsConnectionRetry}"/>
                            <Button Classes="au-button"
                                    Command="{Binding Login.RetryConnectionCommand}"
                                    IsVisible="{Binding Login.IsConnectionRetry}"
                                    HorizontalAlignment="Stretch"
                                    Content="Retry connection"/>
                            <Button Classes="au-button"
                                    Command="{Binding Login.SignInCommand}"
                                    IsEnabled="{Binding !Login.IsBusy}"
                                    IsVisible="{Binding !Login.IsConnectionRetry}"
                                    HorizontalAlignment="Stretch"
                                    Content="Sign in"/>
                            <TextBlock Text="{Binding Login.ErrorMessage}"
                                       Foreground="{DynamicResource AgentUpColorStatusDangerBrush}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Login.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Panel>

            <Grid IsVisible="{Binding !Login.IsVisible}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <!-- ValidationPanel needs its own column: sharing column 2 with GitPanel let the
                     later-declared GitPanel render on top whenever both toggles were open. -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <!-- ── Sidebar ───────────────────────────────────────────────────────── -->
        <Border Grid.Column="0"
                x:Name="SidebarRail"
                Classes="au-rail"
                Width="{Binding Sidebar.Width}">
            <DockPanel>

                <!-- Header (expanded only) -->
                <Border DockPanel.Dock="Top"
                        Padding="16,10,10,6"
                        IsVisible="{Binding Sidebar.IsExpanded}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Classes="au-eyebrow"
                                   Text="Workspaces"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                x:Name="AddWorkspaceButton"
                                Command="{Binding Sidebar.ShowAddWorkspaceCommand}"
                                ToolTip.Tip="Clone a repository into a new workspace">
                            <Border Classes="wsAddButton">
                                <TextBlock Classes="wsAddIcon" Text="+"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <!-- Add button above the avatar list (collapsed only) -->
                <Border DockPanel.Dock="Top"
                        Padding="0,10,0,6"
                        IsVisible="{Binding Sidebar.IsCollapsed}">
                    <Button x:Name="AddWorkspaceButtonCollapsed"
                            HorizontalAlignment="Center"
                            Command="{Binding Sidebar.ShowAddWorkspaceCommand}"
                            ToolTip.Tip="Clone a repository into a new workspace">
                        <Border Classes="wsAddButton">
                            <TextBlock Classes="wsAddIcon" Text="+"/>
                        </Border>
                    </Button>
                </Border>

                <!-- Expanded workspace list -->
                <ScrollViewer x:Name="WorkspaceListExpanded"
                              IsVisible="{Binding Sidebar.IsExpanded}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox HorizontalAlignment="Stretch"
                             Width="{Binding #SidebarRail.Bounds.Width}"
                             ItemsSource="{Binding Sidebar.Workspaces}"
                             SelectedItem="{Binding Sidebar.SelectedWorkspace}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:WorkspaceItemViewModel">
                                <Border Margin="0,2"
                                        HorizontalAlignment="Stretch">
                                    <Border Classes="wsEntry"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="{Binding RepositoryToolTip}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Button Grid.Column="0"
                                                    Command="{Binding StartCommand}"
                                                    IsVisible="{Binding ShowStartButton}"
                                                    IsEnabled="{Binding !IsLifecycleBusy}"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Start workspace">
                                                <Border Classes="wsLifecycleButton">
                                                    <TextBlock Classes="wsLifecycleIcon wsLifecycleIconPlay"
                                                               Text="▶"/>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="0"
                                                    Command="{Binding StopCommand}"
                                                    IsVisible="{Binding ShowStopButton}"
                                                    IsEnabled="{Binding !IsLifecycleBusy}"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Stop workspace">
                                                <Border Classes="wsLifecycleButton">
                                                    <TextBlock Classes="wsLifecycleIcon" Text="■"/>
                                                </Border>
                                            </Button>
                                            <Grid Grid.Column="1">
                                                <StackPanel Spacing="3">
                                                    <DockPanel LastChildFill="True">
                                                        <Border DockPanel.Dock="Left"
                                                                Width="6" Height="6"
                                                                CornerRadius="3"
                                                                Background="{Binding StateColor}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,7,0"/>
                                                        <TextBlock Classes="wsName"
                                                                   Text="{Binding DisplayName}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                    </DockPanel>
                                                    <TextBlock Classes="wsBranch"
                                                               Text="{Binding Branch}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="13,0,0,0"/>
                                                </StackPanel>
                                                <Button Classes="wsDeleteButton"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-2,-2,0"
                                                        Command="{Binding RequestDeleteCommand}"
                                                        ToolTip.Tip="Remove workspace">
                                                    <TextBlock Text="✕"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Collapsed avatar list -->
                <ScrollViewer x:Name="WorkspaceListCollapsed"
                              IsVisible="{Binding Sidebar.IsCollapsed}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox
                             ItemsSource="{Binding Sidebar.Workspaces}"
                             SelectedItem="{Binding Sidebar.SelectedWorkspace}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:WorkspaceItemViewModel">
                                <Border HorizontalAlignment="Center" Padding="0,4">
                                    <Border Classes="wsAvatar"
                                            ToolTip.Tip="{Binding DisplayName}">
                                        <TextBlock Text="{Binding Initials}"
                                                   Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ── Main content ───────────────────────────────────────────────────── -->
        <Border Grid.Column="1" Background="{DynamicResource AgentUpColorCanvasBrush}">
            <Panel>

                <!-- Loading -->
                <TextBlock x:Name="LoadingIndicator"
                           IsVisible="{Binding Sidebar.IsLoading}"
                           Classes="au-muted"
                           Text="Connecting to server…"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Error -->
                <Panel x:Name="ErrorPanel"
                       IsVisible="{Binding Sidebar.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Border Classes="au-error-banner"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding Sidebar.ErrorMessage}"
                                       Foreground="{DynamicResource AgentUpColorStatusDangerBrush}"
                                       FontSize="13"/>
                            <Button Classes="au-button"
                                    Command="{Binding Sidebar.RefreshCommand}"
                                    HorizontalAlignment="Center"
                                    Content="Retry"/>
                        </StackPanel>
                    </Border>
                </Panel>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState"
                            IsVisible="{Binding Sidebar.ShowEmptyState}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <TextBlock Classes="au-page-title"
                               Text="No workspaces"
                               HorizontalAlignment="Center"/>
                    <TextBlock Classes="au-muted"
                               Text="Clone a repository with + to get started."
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Workspace detail: app tabs + sub-navbar + content -->
                <Border x:Name="WorkspaceDetail"
                        IsVisible="{Binding Sidebar.SelectedWorkspace, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">

                        <!-- Application tab bar -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource AgentUpColorSurfaceBrush}"
                                BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <ListBox x:Name="ApplicationTabs"
                                     ItemsSource="{Binding Applications.Applications}"
                                     SelectedItem="{Binding Applications.SelectedApplication}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="appVm:ApplicationViewModel">
                                        <Border Classes="appTab">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="6" Height="6" CornerRadius="3"
                                                        Background="{Binding StateColor}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Sub-navbar: Console + port tabs for the selected app -->
                        <Border Grid.Row="1"
                                IsVisible="{Binding Applications.SelectedApplication, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Background="{DynamicResource AgentUpColorCanvasBrush}"
                                BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="14,8">
                            <ListBox x:Name="SubNavBar"
                                     ItemsSource="{Binding SubTabs}"
                                     SelectedItem="{Binding SelectedSubTab}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <!-- Templates resolved from Window.DataTemplates by type -->
                            </ListBox>
                        </Border>

                        <!-- Browser address bar for HTTP port tabs -->
                        <Border Grid.Row="2"
                                x:Name="AddressNavBar"
                                IsVisible="{Binding ShowPortView}"
                                Background="{DynamicResource AgentUpColorCanvasBrush}"
                                BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,7">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                                  ColumnSpacing="6">
                                <Button Grid.Column="0"
                                        x:Name="BrowserBackButton"
                                        Command="{Binding BrowserBackCommand}"
                                        ToolTip.Tip="Back">
                                    <Border Classes="browserButton">
                                        <TextBlock Text="‹"
                                                   Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button Grid.Column="1"
                                        x:Name="BrowserForwardButton"
                                        Command="{Binding BrowserForwardCommand}"
                                        ToolTip.Tip="Forward">
                                    <Border Classes="browserButton">
                                        <TextBlock Text="›"
                                                   Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button Grid.Column="2"
                                        x:Name="BrowserReloadButton"
                                        Command="{Binding BrowserReloadCommand}"
                                        ToolTip.Tip="Reload">
                                    <Border Classes="browserButton">
                                        <TextBlock Text="↺"
                                                   Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <TextBox Grid.Column="3"
                                         x:Name="AddressBar"
                                         Classes="addressBar"
                                         Text="{Binding AddressBarUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Stretch">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter"
                                                    Command="{Binding NavigateAddressCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- Content area -->
                        <Panel Grid.Row="3">

                            <!-- No applications configured -->
                            <StackPanel IsVisible="{Binding Applications.SelectedApplication, Converter={x:Static ObjectConverters.IsNull}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <TextBlock Classes="au-page-title"
                                           Text="No apps in this workspace"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Classes="au-muted"
                                           Text="Add an agent-up.json with an applications list."
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Console output — populated by code-behind with a NativeWebView -->
                            <Grid IsVisible="{Binding ShowConsole}"
                                  RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0"
                                           IsVisible="{Binding Console.WasTruncated}"
                                           Text="Server output was capped at 50,000 lines."
                                           Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                           FontSize="11"
                                           Margin="20,8,20,0"/>
                                <Panel x:Name="ConsolePane" Grid.Row="1" />
                                <StackPanel Grid.Row="2"
                                            IsVisible="{Binding Console.HasHiddenLines}"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            Margin="20,6,20,6">
                                    <TextBlock Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Text="Showing last 2,000 lines."/>
                                    <Button Command="{Binding Console.ShowMoreCommand}"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AgentUpColorSurfaceSelectedStrongBrush}"
                                            FontSize="11"
                                            Cursor="Hand"
                                            Content="Show all"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="AuditPanel" IsVisible="{Binding ShowAudit}" RowDefinitions="Auto,Auto,*,Auto">
                                <StackPanel Grid.Row="0" Margin="16,12,16,0" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding Audit.ToggleStreamingCommand}">
                                            <Border Classes="tutorialSecondaryButton">
                                                <TextBlock Text="{Binding Audit.StreamingButtonText}" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="11"/>
                                            </Border>
                                        </Button>
                                        <Button Command="{Binding Audit.RefreshCommand}" IsEnabled="{Binding Audit.CanRefresh}">
                                            <Border Classes="tutorialSecondaryButton">
                                                <TextBlock Text="Refresh" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="11"/>
                                            </Border>
                                        </Button>
                                        <TextBox x:Name="AuditSearchBox"
                                                 Classes="addressBar"
                                                 MinWidth="220"
                                                 PlaceholderText="Search diagnostics"
                                                 Text="{Binding Audit.SearchText, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <TextBlock Text="Categories"
                                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                               FontSize="11"
                                               FontWeight="Medium"/>
                                    <ItemsControl ItemsSource="{Binding Audit.KindFilters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Classes="filterChip"
                                                              IsChecked="{Binding IsSelected}">
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}" FontSize="11"/>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Audit.EmptyMessage}"
                                               IsVisible="{Binding Audit.ShowEmptyState}"
                                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Row="2" Margin="16,8,16,0" RowDefinitions="Auto,*">
                                    <Border Grid.Row="0" Classes="auditTableHeader">
                                        <Grid ColumnDefinitions="72,72,*" ColumnSpacing="10">
                                            <TextBlock Grid.Column="0" Text="Time" Foreground="{DynamicResource AgentUpColorTextMutedBrush}" FontSize="10" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="Type" Foreground="{DynamicResource AgentUpColorTextMutedBrush}" FontSize="10" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="2" Text="Message" Foreground="{DynamicResource AgentUpColorTextMutedBrush}" FontSize="10" FontWeight="Medium"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1">
                                        <ItemsControl x:Name="AuditEventList" ItemsSource="{Binding Audit.Events}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="auditTableRow">
                                                        <Grid ColumnDefinitions="72,72,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="{DynamicResource AgentUpColorTextMutedBrush}" FontSize="10" VerticalAlignment="Top"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{Binding CategoryColor}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{Binding MessageColor}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="20,8" VerticalAlignment="Center">
                                    <Button x:Name="AuditFirstPageButton" Classes="auditPageJump" Command="{Binding Audit.FirstPageCommand}" IsEnabled="{Binding Audit.CanGoFirst}" ToolTip.Tip="First page">
                                        <Border Classes="auditPageJumpInner"><TextBlock Text="&#xAB;" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="11" HorizontalAlignment="Center"/></Border>
                                    </Button>
                                    <Button x:Name="AuditPreviousPageButton" Classes="auditPageJump" Command="{Binding Audit.PreviousPageCommand}" IsEnabled="{Binding Audit.CanGoPrevious}" ToolTip.Tip="Previous page">
                                        <Border Classes="auditPageJumpInner"><TextBlock Text="&#x2039;" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/></Border>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Audit.PageJumpButtons}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="auditPageJump" Command="{Binding JumpCommand}">
                                                    <Border Classes="auditPageJumpInner" Classes.auditPageJumpInnerCurrent="{Binding IsCurrent}">
                                                        <TextBlock Text="{Binding PageNumber}" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="AuditNextPageButton" Classes="auditPageJump" Command="{Binding Audit.NextPageCommand}" IsEnabled="{Binding Audit.CanGoNext}" ToolTip.Tip="Next page">
                                        <Border Classes="auditPageJumpInner"><TextBlock Text="&#x203A;" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/></Border>
                                    </Button>
                                    <Button x:Name="AuditLastPageButton" Classes="auditPageJump" Command="{Binding Audit.LastPageCommand}" IsEnabled="{Binding Audit.CanGoLast}" ToolTip.Tip="Last page">
                                        <Border Classes="auditPageJumpInner"><TextBlock Text="&#xBB;" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="11" HorizontalAlignment="Center"/></Border>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Port view: browser WebViews are added/swapped here in code-behind -->
                            <Panel x:Name="PortPane"
                                   IsVisible="{Binding ShowPortView}">
                                <!-- Shown only when NativeWebView creation fails for the active workspace -->
                                <Border x:Name="WebViewErrorBanner"
                                        IsVisible="False"
                                        ZIndex="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AgentUpColorSurfaceDangerBrush}"
                                        BorderBrush="{DynamicResource AgentUpColorStatusDangerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="24,20">
                                    <TextBlock x:Name="WebViewErrorText"
                                               Foreground="{DynamicResource AgentUpColorStatusDangerBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               MaxWidth="400"/>
                                </Border>
                            </Panel>

                            <!-- TCP port placeholder -->
                            <StackPanel IsVisible="{Binding ShowTcpInfo}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <TextBlock Text="TCP port"
                                           Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="This port is not an HTTP service."
                                           Foreground="{DynamicResource AgentUpColorBorderStrongBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Database explorer -->
                            <Grid IsVisible="{Binding ShowDatabase}"
                                  ColumnDefinitions="220,*"
                                  Margin="16,12">
                                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,*" RowSpacing="8" Margin="0,0,12,0">
                                    <TextBlock Grid.Row="0"
                                               Text="Databases"
                                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                               FontSize="12"
                                               FontWeight="Medium"/>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding Database.Databases}"
                                             SelectedItem="{Binding Database.SelectedDatabase}"
                                             Background="{DynamicResource AgentUpColorSurfaceBrush}"
                                             BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                                             BorderThickness="1"
                                             Padding="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="dbListItem" Margin="0,1">
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                                               FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="2"
                                               Text="Tables"
                                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                               FontSize="12"
                                               FontWeight="Medium"/>
                                    <ListBox Grid.Row="3"
                                             ItemsSource="{Binding Database.Tables}"
                                             SelectedItem="{Binding Database.SelectedTable}"
                                             Background="{DynamicResource AgentUpColorSurfaceBrush}"
                                             BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                                             BorderThickness="1"
                                             Padding="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="dbListItem" Margin="0,1">
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                                               FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right"
                                                Classes="dbRunButton"
                                                Content="Run"
                                                Command="{Binding Database.RunQueryCommand}"
                                                Margin="8,0,0,0"/>
                                        <TextBox Classes="sqlEditor"
                                                 Text="{Binding Database.SqlQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 PlaceholderText="SQL query"/>
                                    </DockPanel>

                                    <Border Grid.Row="1"
                                            Background="{DynamicResource AgentUpColorSurfaceDangerBrush}"
                                            BorderBrush="{DynamicResource AgentUpColorStatusDangerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,0,0,8"
                                            IsVisible="{Binding Database.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding Database.ErrorMessage}"
                                                   Foreground="{DynamicResource AgentUpColorStatusDangerBrush}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   FontSize="11"/>
                                    </Border>

                                    <ScrollViewer Grid.Row="2"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  IsVisible="{Binding Database.HasResults}">
                                        <StackPanel Spacing="0">
                                            <ItemsControl ItemsSource="{Binding Database.Columns}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="dbHeaderCell"
                                                                Width="{Binding Width}">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                                                       FontWeight="Bold"
                                                                       FontSize="11"
                                                                       FontFamily="Consolas,Courier New,monospace"
                                                                       TextWrapping="NoWrap"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding Database.Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="databaseViewsVm:DatabaseRowViewModel">
                                                        <ItemsControl ItemsSource="{Binding Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Classes="dbDataCell"
                                                                            Width="{Binding Width}">
                                                                        <TextBox Classes="dbCell"
                                                                                 Text="{Binding Value}"
                                                                                 TextWrapping="NoWrap"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="2"
                                                IsVisible="{Binding Database.ShowEmptyState}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <TextBlock Text="Select a table or run a query."
                                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                IsVisible="{Binding Database.IsLoading}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <TextBlock Text="Loading database..."
                                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Metrics dashboard -->
                            <Grid IsVisible="{Binding ShowMetrics}"
                                  RowDefinitions="Auto,*">
                                <DockPanel Grid.Row="0" Margin="20,14,20,0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Metrics.LastUpdated}"
                                               Foreground="{DynamicResource AgentUpColorBorderStrongBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Application metrics"
                                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <ScrollViewer Grid.Row="1"
                                              Margin="20,12,20,20"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="18">
                                        <ItemsControl ItemsSource="{Binding Metrics.SummaryCards}"
                                                      IsVisible="{Binding Metrics.HasSummary}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Metrics.Charts}"
                                                      IsVisible="{Binding Metrics.HasCharts}"/>

                                        <StackPanel IsVisible="{Binding Metrics.IsLoading}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="8"
                                                    Margin="0,40,0,0">
                                            <TextBlock Text="Loading metrics..."
                                                       Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding Metrics.ShowEmptyState}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="8"
                                                    Margin="0,40,0,0">
                                            <TextBlock Text="{Binding Metrics.EmptyMessage}"
                                                       Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       MaxWidth="420"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                        </Panel>

                    </Grid>
                </Border>

            </Panel>
        </Border>

        <Border x:Name="ValidationPanel" Grid.Column="3" Width="360" Background="{DynamicResource AgentUpColorSurfaceBrush}" BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}" BorderThickness="1,0,0,0" IsVisible="{Binding IsValidationOpen}" Padding="18">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <DockPanel><TextBlock Text="Validation" Foreground="{DynamicResource AgentUpColorAccentSoftBrush}" FontSize="18" FontWeight="Bold"/><Button DockPanel.Dock="Right" Command="{Binding ToggleValidationCommand}"><TextBlock Text="×" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="20"/></Button></DockPanel>
                <TextBlock Grid.Row="1" Text="Behavioral checks for the selected application" Foreground="{DynamicResource AgentUpColorTextMutedBrush}" FontSize="12"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10">
                    <TextBlock Text="{Binding Validation.Status}"
                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Validation.Status, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <ItemsControl x:Name="ValidationFlowList" ItemsSource="{Binding Validation.Flows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="validationVm:ValidationFlowItemViewModel">
                                <Border Classes="au-validation-stage" Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StatusGlyph}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Width="18"
                                                       VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource AgentUpColorTextMutedBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding InitialPath, StringFormat='Starts at {0}'}" Foreground="{DynamicResource AgentUpColorTextMutedBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding ResultMessage}"
                                                           Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasRunResult}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Classes="au-button au-button--compact"
                                                    Command="{Binding RunCommand}"
                                                    IsEnabled="{Binding !IsRunning}"
                                                    VerticalAlignment="Top"
                                                    Content="▶ Play"/>
                                        </Grid>

                                        <StackPanel Spacing="6"
                                                    IsVisible="{Binding IsExpanded}"
                                                    Margin="26,0,0,0">
                                            <ItemsControl ItemsSource="{Binding Stages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="validationVm:ValidationStageViewModel">
                                                        <StackPanel Spacing="4" Margin="0,0,0,8">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding StatusGlyph}"
                                                                           Foreground="{Binding StatusColor}"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           Width="14"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Title}"
                                                                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Checks}" Margin="18,0,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="validationVm:ValidationCheckViewModel">
                                                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,3">
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding StatusGlyph}"
                                                                                       Foreground="{Binding StatusColor}"
                                                                                       FontSize="11"
                                                                                       FontWeight="Bold"
                                                                                       Width="14"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Label}"
                                                                                       Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                                                                       FontSize="11"
                                                                                       TextWrapping="Wrap"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel></ScrollViewer>
            </Grid>
        </Border>

        <!-- ── Git changes panel ──────────────────────────────────────────────── -->
        <Border Grid.Column="2"
                x:Name="GitPanel"
                Width="320"
                IsVisible="{Binding Git.IsVisible}"
                Background="{DynamicResource AgentUpColorCanvasBrush}"
                BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <Border Grid.Row="0" Padding="14,12,10,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Git changes"
                                       Foreground="{DynamicResource AgentUpColorAccentSoftBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="GitBranchLabel"
                                       Text="{Binding Git.Branch}"
                                       Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="GitRefreshButton"
                                Command="{Binding Git.RefreshCommand}"
                                ToolTip.Tip="Reload Git changes">
                            <Border Classes="titleToolButton">
                                <TextBlock Classes="chromeIcon" Text="↺" FontSize="14"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="14,0,14,8" Spacing="4">
                    <TextBlock x:Name="GitSelectionSummary"
                               Text="{Binding Git.SelectionSummary}"
                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                               FontSize="11"/>
                    <TextBlock x:Name="GitErrorMessage"
                               Text="{Binding Git.ErrorMessage}"
                               IsVisible="{Binding Git.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{DynamicResource AgentUpColorStatusDangerBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="GitStatusMessage"
                               Text="{Binding Git.StatusMessage}"
                               IsVisible="{Binding Git.StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{DynamicResource AgentUpColorAccentSoftBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Panel Grid.Row="2">
                    <ScrollViewer x:Name="GitChangeTree"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="8,0">
                        <ItemsControl ItemsSource="{Binding Git.Nodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="gitVm:GitChangeNodeViewModel">
                                    <Border Classes="gitNodeRow" Margin="{Binding Indent}">
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      MinWidth="0"
                                                      Padding="0"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Glyph}"
                                                       Foreground="{Binding GlyphColor}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Width="14"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Classes="gitNodeName"
                                                    Command="{Binding OpenCommand}"
                                                    IsEnabled="{Binding IsFile}"
                                                    ToolTip.Tip="{Binding ToolTip}">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{Binding NameColor}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="GitLoadingIndicator"
                               IsVisible="{Binding Git.IsLoading}"
                               Text="Loading changes…"
                               Foreground="{DynamicResource AgentUpColorAccentSoftBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="GitEmptyState"
                               IsVisible="{Binding Git.ShowEmptyState}"
                               Text="No uncommitted changes."
                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Panel>

                <StackPanel Grid.Row="3" Margin="14,8,14,14" Spacing="8">
                    <TextBox x:Name="GitCommitMessage"
                             Text="{Binding Git.CommitMessage}"
                             Watermark="Commit message"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="72"
                             MaxHeight="140"
                             Background="{DynamicResource AgentUpColorSurfaceBrush}"
                             Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                             BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                             BorderThickness="1"
                             FontSize="12"/>
                    <Button x:Name="GitCommitButton"
                            HorizontalAlignment="Stretch"
                            Command="{Binding Git.CommitCommand}">
                        <Border Classes="tutorialButton" HorizontalAlignment="Stretch">
                            <TextBlock Classes="tutorialButtonText"
                                       Text="Commit"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>
        </Grid>

        <Grid x:Name="FirstRunTutorialOverlay"
              ZIndex="90"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsVisible="{Binding Tutorial.IsVisible}"
              IsHitTestVisible="{Binding Tutorial.IsVisible}">
            <Border Background="{DynamicResource AgentUpColorScrimBrush}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            <Border Background="{DynamicResource AgentUpColorScrimBrush}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border.Effect>
                    <BlurEffect Radius="10"/>
                </Border.Effect>
            </Border>

            <Grid RowDefinitions="*,8*,*"
                  ColumnDefinitions="*,8*,*">
            <Border Grid.Row="1"
                    Grid.Column="1"
                    MinWidth="480"
                    MinHeight="320"
                    MaxWidth="900"
                    MaxHeight="620"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource AgentUpColorSurfaceBrush}"
                    BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="6">
                        <TextBlock Text="Agent-Up first run"
                                   Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                   FontSize="28"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Set up a complete two-workspace JavaScript demo before entering the app."
                                   Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                   FontSize="15"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,22,0,22"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            <StackPanel IsVisible="{Binding Tutorial.ShowDockerStep}" Spacing="16">
                                <TextBlock Text="Step 1: Install Docker and Agent-Up"
                                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="15">
                                    <Run Text="Agent-Up needs "/>
                                    <Run Text="Docker" FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                    <Run Text=" for database services and "/>
                                    <Run Text="Agent-Up CLI" FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                    <Run Text=" to register workspaces with the Server."/>
                                </TextBlock>
                                <Button x:Name="TutorialCheckPrerequisitesButton"
                                        Command="{Binding Tutorial.CheckDockerCommand}"
                                        HorizontalAlignment="Left">
                                    <Border Classes="tutorialSecondaryButton">
                                        <TextBlock Classes="tutorialButtonText" Text="Check Prerequisites"/>
                                    </Border>
                                </Button>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowEnvironmentStep}" Spacing="16">
                                <TextBlock Text="Step 2: Choose a development environment"
                                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="15">
                                    <Run Text="Choose the stack Agent-Up should prove end-to-end. The JavaScript path builds a "/>
                                    <Run Text="real React + Express + Postgres workspace" FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                    <Run Text=", then duplicates it to prove port isolation."/>
                                </TextBlock>
                                <Grid ColumnDefinitions="*,*,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="12">
                                    <Button Grid.Column="0"
                                            x:Name="TutorialSelectJavaScriptButton"
                                            Command="{Binding Tutorial.SelectJavaScriptCommand}">
                                        <Border Background="{DynamicResource AgentUpColorSurfaceRaisedBrush}" BorderBrush="{DynamicResource AgentUpColorBorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="JS"
                                                           Foreground="{DynamicResource AgentUpColorStatusWarningBrush}"
                                                           FontSize="30"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Node + JavaScript" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="React SPA, Express API, Postgres" Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Border Grid.Column="1" Background="{DynamicResource AgentUpColorSurfaceBrush}" BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Opacity="0.62">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text=".NET" Foreground="{DynamicResource AgentUpColorFocusBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text=".NET" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Coming later" Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource AgentUpColorSurfaceBrush}" BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Opacity="0.62">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="PY" Foreground="{DynamicResource AgentUpColorStatusWarningBrush}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Python" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Coming later" Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowNodeStep}" Spacing="16">
                                <TextBlock Text="Step 3: Install Node.js 20+"
                                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="15">
                                    <Run Text="The sample apps run on "/>
                                    <Run Text="Node.js 20 or newer" FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                    <Run Text=" with npm. If you install Node while Agent-Up Desktop is open, restart Desktop so it receives the updated PATH."/>
                                </TextBlock>
                                <Button x:Name="TutorialCheckNodeButton"
                                        Command="{Binding Tutorial.CheckNodeCommand}"
                                        HorizontalAlignment="Left">
                                    <Border Classes="tutorialSecondaryButton">
                                        <TextBlock Classes="tutorialButtonText" Text="Check Node"/>
                                    </Border>
                                </Button>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowSampleStep}" Spacing="16">
                                <TextBlock Text="Step 4: Create project files"
                                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="15">
                                    <Run Text="Agent-Up Desktop creates "/>
                                    <Run Text="example-agent1" FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                    <Run Text=" under /tmp/&lt;random-guid&gt;/agent-up-tutorial/ with a React app, an Express API, and docker-compose.yaml for Postgres."/>
                                </TextBlock>
                                <Button x:Name="TutorialCreateProjectFilesButton"
                                        Command="{Binding Tutorial.CreateSampleProjectCommand}"
                                        HorizontalAlignment="Left">
                                    <Border Classes="tutorialSecondaryButton">
                                        <TextBlock Classes="tutorialButtonText" Text="Create Project Files"/>
                                    </Border>
                                </Button>
                                <StackPanel IsVisible="{Binding Tutorial.ShowProjectFileCheckSection}"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Tutorial.ProjectDirectory}"
                                               Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="These are the files Agent-Up will manage. The smoke check confirms the project shape is complete."
                                               Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                    <TextBox IsVisible="{Binding Tutorial.ShowDirectoryTree}"
                                             Text="{Binding Tutorial.DirectoryTree}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="Consolas,Courier New,monospace"
                                             FontSize="12"
                                             MinHeight="130"
                                             Background="{DynamicResource AgentUpColorCanvasBrush}"
                                             BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                                             Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                             Padding="12"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="OpenTutorialFolderButton"
                                                Click="OnOpenTutorialFolderClicked">
                                            <Border Classes="tutorialSecondaryButton">
                                                <TextBlock Classes="tutorialButtonText" Text="Open File Explorer"/>
                                            </Border>
                                        </Button>
                                        <Button x:Name="TutorialCheckProjectFilesButton"
                                                Command="{Binding Tutorial.CheckProjectFilesCommand}">
                                            <Border Classes="tutorialSecondaryButton">
                                                <TextBlock Classes="tutorialButtonText" Text="Check Project Files"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowAgentUpJsonStep}" Spacing="16">
                                <TextBlock Text="Step 5: Create agent-up.json"
                                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="15">
                                    <Run Text="agent-up.json is the "/>
                                    <Run Text="contract between your project and Agent-Up" FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                    <Run Text=". It declares the two Node apps and starts Postgres with docker compose."/>
                                </TextBlock>
                                <TextBox Text="{Binding Tutorial.Snippet}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas,Courier New,monospace"
                                         FontSize="12"
                                         MinHeight="220"
                                         Background="{DynamicResource AgentUpColorCanvasBrush}"
                                         BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                                         Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                         Padding="12"/>
                                <StackPanel Spacing="10" Margin="0,8,0,0">
                                    <TextBlock Text="Agent-Up Desktop writes this file for you, then checks it before continuing."
                                               Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="TutorialCreateAgentUpJsonButton"
                                            HorizontalAlignment="Left"
                                            Command="{Binding Tutorial.CreateAgentUpJsonCommand}">
                                        <Border Classes="tutorialSecondaryButton">
                                            <TextBlock Classes="tutorialButtonText" Text="Create agent-up.json"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding Tutorial.ShowAgentUpJsonCheckSection}"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="Now check that agent-up.json exists and can be parsed."
                                               Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="TutorialCheckAgentUpJsonButton"
                                            Command="{Binding Tutorial.CheckAgentUpJsonCommand}"
                                            HorizontalAlignment="Left">
                                        <Border Classes="tutorialSecondaryButton">
                                            <TextBlock Classes="tutorialButtonText" Text="Check agent-up.json"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowStartStep}" Spacing="16">
                                <TextBlock Text="Step 6: Start the workspace"
                                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="15">
                                    <Run Text="Starting the workspace registers it with the "/>
                                    <Run Text="Agent-Up Server" FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                    <Run Text=", launches the declared apps, and assigns ports from the workspace range."/>
                                </TextBlock>
                                <StackPanel Spacing="10" Margin="0,8,0,0">
                                    <Button x:Name="TutorialStartWorkspaceButton"
                                            Command="{Binding Tutorial.StartWorkspaceCommand}"
                                            HorizontalAlignment="Left">
                                        <Border Classes="tutorialSecondaryButton">
                                            <TextBlock Classes="tutorialButtonText" Text="Run agent-up start"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding Tutorial.ShowCommandOutput}"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="Command output"
                                               Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBox Text="{Binding Tutorial.CommandOutput}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas,Courier New,monospace"
                                             FontSize="12"
                                             MinHeight="120"
                                             Background="{DynamicResource AgentUpColorCanvasBrush}"
                                             BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                                             Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                             Padding="12"/>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding Tutorial.ShowWorkspaceCheckSection}"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="The command succeeded. Now ask the Server whether it sees React, Express, and Postgres."
                                               Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="TutorialCheckWorkspaceButton"
                                            Command="{Binding Tutorial.CheckWorkspaceCommand}"
                                            HorizontalAlignment="Left">
                                        <Border Classes="tutorialSecondaryButton">
                                            <TextBlock Classes="tutorialButtonText" Text="Check Workspace"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowDuplicateStep}" Spacing="16">
                                <TextBlock Text="Step 7: Duplicate the workspace"
                                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="15">
                                    <Run Text="Now Agent-Up copies "/>
                                    <Run Text="example-agent1 to example-agent2" FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                    <Run Text=" under the same tutorial root and starts it too. This proves two agents can run the same project without port collisions."/>
                                </TextBlock>
                                <Button x:Name="TutorialCreateDuplicateButton"
                                        Command="{Binding Tutorial.MarkDuplicateStartedCommand}"
                                        HorizontalAlignment="Left">
                                    <Border Classes="tutorialSecondaryButton">
                                        <TextBlock Classes="tutorialButtonText" Text="Create and Start example-agent2"/>
                                    </Border>
                                </Button>
                                <StackPanel IsVisible="{Binding Tutorial.ShowDuplicateCheckSection}"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="The duplicate has started. Check that both workspaces are registered and every allocated port is unique."
                                               Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="TutorialCheckDuplicateButton"
                                            Command="{Binding Tutorial.CheckDuplicateCommand}"
                                            HorizontalAlignment="Left">
                                        <Border Classes="tutorialSecondaryButton">
                                            <TextBlock Classes="tutorialButtonText" Text="Check Duplicate"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowSuccessStep}" Spacing="16">
                                <TextBlock Text="You just proved the core Agent-Up workflow"
                                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                           FontSize="24"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="16">
                                    <Run Text="Agent-Up created "/>
                                    <Run Text="two isolated workspaces" FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                    <Run Text=" from the same JavaScript project, started the same React, Express, and Postgres components in both, and let the Server allocate ports without collisions."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="16">
                                    <Run Text="The second workspace also has "/>
                                    <Run Text="different seeded product data" FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                    <Run Text=", so the React dashboard table makes it obvious which isolated environment you are viewing."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="16">
                                    <Run Text="That matters because agents can now work in parallel on duplicate environments while sharing the same runtime rules: "/>
                                    <Run Text="workspace identity, process lifecycle, Docker, browser profiles, diagnostics, and ports all stay Server-owned." FontWeight="Bold" Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border IsVisible="{Binding Tutorial.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Background="{DynamicResource AgentUpColorCanvasBrush}"
                                    BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <TextBlock x:Name="TutorialStatusMessage"
                                           Text="{Binding Tutorial.StatusMessage}"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                          ColumnSpacing="10">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Tutorial.CurrentStep, StringFormat='Step {0} of 8'}"
                                   Foreground="{DynamicResource AgentUpColorAccentSoftBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Command="{Binding Tutorial.BackCommand}"
                                IsEnabled="{Binding Tutorial.CanGoBack}">
                            <Border Classes="tutorialSecondaryButton">
                                <TextBlock Classes="tutorialButtonText" Text="Back"/>
                            </Border>
                        </Button>
                        <Button Grid.Column="3"
                                x:Name="TutorialContinueButton"
                                Command="{Binding Tutorial.ContinueCommand}"
                                IsEnabled="{Binding Tutorial.CanContinue}">
                            <Border Classes="tutorialButton">
                                <TextBlock Classes="tutorialButtonText"
                                           Text="{Binding Tutorial.PrimaryButtonText}"/>
                            </Border>
                        </Button>
                        <Button Grid.Column="4"
                                x:Name="SkipTutorialButton"
                                Command="{Binding Tutorial.SkipCommand}">
                            <Border Classes="tutorialSecondaryButton">
                                <TextBlock Classes="tutorialButtonText" Text="Skip"/>
                            </Border>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <Grid ZIndex="100"
              x:Name="AddWorkspaceOverlay"
              IsVisible="{Binding Sidebar.AddWorkspace.IsVisible}"
              IsHitTestVisible="{Binding Sidebar.AddWorkspace.IsVisible}">
            <Border Background="{DynamicResource AgentUpColorScrimBrush}"/>
            <Border Background="{DynamicResource AgentUpColorScrimBrush}">
                <Border.Effect>
                    <BlurEffect Radius="10"/>
                </Border.Effect>
            </Border>

            <Grid RowDefinitions="*,8*,*"
                  ColumnDefinitions="*,8*,*">
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Classes="au-card"
                        MinWidth="460"
                        MaxWidth="600"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Add workspace"
                                       Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Agent-Up clones the repository into its managed source clones directory and registers the workspace."
                                       Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Repository"
                                       Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBox x:Name="AddWorkspaceRepository"
                                     Classes="au-input"
                                     Text="{Binding Sidebar.AddWorkspace.Repository}"
                                     Watermark="https://github.com/acme/widgets.git"
                                     IsEnabled="{Binding !Sidebar.AddWorkspace.IsBusy}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Branch"
                                       Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBox x:Name="AddWorkspaceBranch"
                                     Classes="au-input"
                                     Text="{Binding Sidebar.AddWorkspace.Branch}"
                                     Watermark="main"
                                     IsEnabled="{Binding !Sidebar.AddWorkspace.IsBusy}"/>
                        </StackPanel>

                        <TextBlock x:Name="AddWorkspaceError"
                                   Text="{Binding Sidebar.AddWorkspace.ErrorMessage}"
                                   IsVisible="{Binding Sidebar.AddWorkspace.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Foreground="{DynamicResource AgentUpColorStatusDangerBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <Button Grid.Column="1"
                                    x:Name="AddWorkspaceCancelButton"
                                    Classes="au-button au-button--secondary"
                                    Command="{Binding Sidebar.AddWorkspace.CancelCommand}"
                                    Content="Cancel"/>
                            <Button Grid.Column="2"
                                    x:Name="AddWorkspaceConfirmButton"
                                    Classes="au-button"
                                    Command="{Binding Sidebar.AddWorkspace.ConfirmCommand}"
                                    Content="{Binding Sidebar.AddWorkspace.ConfirmLabel}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid ZIndex="100"
              x:Name="GitFileDiffOverlay"
              IsVisible="{Binding Git.Diff.IsVisible}"
              IsHitTestVisible="{Binding Git.Diff.IsVisible}">
            <Border Background="{DynamicResource AgentUpColorScrimBrush}"/>
            <Border Background="{DynamicResource AgentUpColorScrimBrush}">
                <Border.Effect>
                    <BlurEffect Radius="10"/>
                </Border.Effect>
            </Border>

            <Grid RowDefinitions="*,10*,*"
                  ColumnDefinitions="*,10*,*">
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Classes="au-card">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock x:Name="GitFileDiffPath"
                                           Text="{Binding Git.Diff.Path}"
                                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GitFileDiffStatus"
                                           Text="{Binding Git.Diff.Status}"
                                           Foreground="{DynamicResource AgentUpColorTextMutedBrush}"
                                           FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="GitFileDiffCloseButton"
                                    Command="{Binding Git.Diff.CloseCommand}"
                                    ToolTip.Tip="Close">
                                <Border Classes="chromeButton">
                                    <TextBlock Classes="chromeIcon chromeCloseIcon" Text="×"/>
                                </Border>
                            </Button>
                        </Grid>

                        <Panel Grid.Row="1">
                            <TextBlock IsVisible="{Binding Git.Diff.IsLoading}"
                                       Text="Loading diff…"
                                       Foreground="{DynamicResource AgentUpColorAccentSoftBrush}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="GitFileDiffContent"
                                           Text="{Binding Git.Diff.Content}"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                           FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                           FontSize="12"/>
                            </ScrollViewer>
                        </Panel>

                        <Button Grid.Row="2"
                                x:Name="GitFileDiffDismissButton"
                                HorizontalAlignment="Right"
                                Command="{Binding Git.Diff.CloseCommand}">
                            <Border Classes="tutorialSecondaryButton">
                                <TextBlock Classes="tutorialButtonText" Text="Close"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid ZIndex="100"
              x:Name="WorkspaceDeleteOverlay"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsVisible="{Binding Sidebar.DeleteConfirmation.IsVisible}"
              IsHitTestVisible="{Binding Sidebar.DeleteConfirmation.IsVisible}">
            <Border Background="{DynamicResource AgentUpColorScrimBrush}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            <Border Background="{DynamicResource AgentUpColorScrimBrush}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border.Effect>
                    <BlurEffect Radius="10"/>
                </Border.Effect>
            </Border>

            <Grid RowDefinitions="*,8*,*"
                  ColumnDefinitions="*,8*,*">
                <Border Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="420"
                        MaxWidth="560"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource AgentUpColorSurfaceBrush}"
                        BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="28">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Remove workspace"
                                       Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding Sidebar.DeleteConfirmation.Message}"
                                       Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <CheckBox x:Name="WorkspaceDeleteConfirmCheckbox"
                                  Content="I understand this removes the workspace from Agent-Up"
                                  Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"
                                  FontSize="13"
                                  IsChecked="{Binding Sidebar.DeleteConfirmation.ConfirmChecked}"/>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <Button Grid.Column="1"
                                    x:Name="WorkspaceDeleteCancelButton"
                                    Command="{Binding Sidebar.DeleteConfirmation.CancelCommand}">
                                <Border Classes="tutorialSecondaryButton">
                                    <TextBlock Classes="tutorialButtonText" Text="Cancel"/>
                                </Border>
                            </Button>
                            <Button Grid.Column="2"
                                    x:Name="WorkspaceDeleteConfirmButton"
                                    Command="{Binding Sidebar.DeleteConfirmation.ConfirmCommand}">
                                <Border Classes="tutorialButton">
                                    <TextBlock Classes="tutorialButtonText" Text="Delete"/>
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
