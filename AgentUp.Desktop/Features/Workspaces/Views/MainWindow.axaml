<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentUp.Desktop.Features.Workspaces.ViewModels"
        xmlns:appVm="using:AgentUp.Desktop.Features.Applications.ViewModels"
        xmlns:portVm="using:AgentUp.Desktop.Features.Ports.ViewModels"
        xmlns:metricsVm="using:AgentUp.Desktop.Features.Metrics.ViewModels"
        xmlns:databaseVm="using:AgentUp.Desktop.Features.Ports.ViewModels"
        xmlns:databaseViewsVm="using:AgentUp.Desktop.Features.Database.ViewModels"
        xmlns:gitVm="using:AgentUp.Desktop.Features.Git.ViewModels"
        xmlns:validationVm="using:AgentUp.Desktop.Features.Validation.ViewModels"
        xmlns:metricsViews="using:AgentUp.Desktop.Features.Metrics.Views"
        xmlns:chromeVm="using:AgentUp.Desktop.Features.Workspaces.ViewModels.Chrome"
        x:Class="AgentUp.Desktop.Features.Workspaces.Views.MainWindow"
        x:CompileBindings="False"
        Width="1100" Height="700"
        MinWidth="640" MinHeight="400"
        Title="Agent-Up"
        WindowDecorations="None"
        Background="#000000">

    <Window.DataTemplates>
        <!-- Console sub-tab -->
        <DataTemplate DataType="portVm:ConsoleSubTabViewModel">
            <Border Classes="subTab" Padding="13,7">
                <TextBlock Text="Console"
                           Foreground="#c2d2ca"
                           FontSize="12"
                           FontWeight="Bold"/>
            </Border>
        </DataTemplate>

        <!-- Database sub-tab -->
        <DataTemplate DataType="databaseVm:DatabaseSubTabViewModel">
            <Border Classes="subTab" Padding="13,7">
                <TextBlock Text="Database"
                           Foreground="#c2d2ca"
                           FontSize="12"
                           FontWeight="Bold"/>
            </Border>
        </DataTemplate>

        <!-- Metrics sub-tab -->
        <DataTemplate DataType="portVm:MetricsSubTabViewModel">
            <Border Classes="subTab" Padding="13,7">
                <TextBlock Text="Metrics"
                           Foreground="#c2d2ca"
                           FontSize="12"
                           FontWeight="Bold"/>
            </Border>
        </DataTemplate>

        <!-- Audit sub-tab -->
        <DataTemplate DataType="portVm:AuditSubTabViewModel">
            <Border Classes="subTab" Padding="13,7">
                <TextBlock Text="Audit" Foreground="#c2d2ca" FontSize="12" FontWeight="Bold"/>
            </Border>
        </DataTemplate>

        <!-- Metrics chart card -->
        <DataTemplate DataType="metricsVm:MetricsChartViewModel">
            <Border Classes="metricsChartCard" Margin="0,0,0,16">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#d8eadf"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding Unit}"
                                       Foreground="#6f857a"
                                       FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LatestDisplay}"
                                   Foreground="#22c55e"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <metricsViews:MetricsTimeSeriesChart Grid.Row="1"
                                                         Points="{Binding Points}"
                                                         Unit="{Binding Unit}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Metrics summary card -->
        <DataTemplate DataType="metricsVm:MetricsSummaryCardViewModel">
            <Border Classes="metricsSummaryCard">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Label}"
                               Foreground="#6f857a"
                               FontSize="11"
                               FontWeight="Medium"/>
                    <TextBlock Text="{Binding Value}"
                               Foreground="#f5fbf7"
                               FontSize="24"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Port sub-tab -->
        <DataTemplate DataType="portVm:PortSubTabViewModel">
            <Border Classes="subTab" Padding="13,7">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Border Width="6" Height="6"
                            CornerRadius="3"
                            Background="{Binding StatusColor}"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}"
                               Foreground="#f5fbf7"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="chromeVm:ChromeIconButtonViewModel">
            <Button Name="{Binding Name}"
                    Command="{Binding Command}"
                    ToolTip.Tip="{Binding ToolTip}">
                <Border Classes="titleToolButton">
                    <TextBlock Classes="chromeIcon"
                               Text="{Binding Icon}"
                               FontSize="{Binding FontSize}"/>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate DataType="chromeVm:ChromeServerStatusViewModel">
            <Border x:Name="ServerStatusBadge"
                    Margin="6,0,0,0"
                    Padding="12,5"
                    CornerRadius="999"
                    BorderBrush="{Binding ServerStatusColor}"
                    BorderThickness="1"
                    Background="#030303"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="9"
                            Height="9"
                            CornerRadius="5"
                            Background="{Binding ServerStatusColor}"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServerStatusText"
                               Text="{Binding ServerStatusText}"
                               Foreground="#f5fbf7"
                               FontSize="11"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <!-- Strip default ListBox chrome -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Strip default Button chrome -->
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Integrated window chrome -->
        <Style Selector="Border.chromeButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button:pointerover Border.chromeButton">
            <Setter Property="Background" Value="#0d4f32"/>
        </Style>
        <Style Selector="Button:pointerover Border.chromeClose">
            <Setter Property="Background" Value="#c42b1c"/>
        </Style>
        <Style Selector="TextBlock.chromeIcon">
            <Setter Property="Foreground" Value="#f5fbf7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.chromeMinimizeIcon">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="LineHeight" Value="15"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
        <Style Selector="TextBlock.chromeRestoreIcon">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="14"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style Selector="TextBlock.chromeCloseIcon">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Margin" Value="0,-5,0,0"/>
        </Style>
        <Style Selector="Border.titleToolButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button:pointerover Border.titleToolButton">
            <Setter Property="Background" Value="#0d4f32"/>
        </Style>

        <!-- Application tab bar -->
        <Style Selector="Border.appTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.appTab">
            <Setter Property="Background" Value="#0a0a0a"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.appTab">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>

        <!-- Sub-navbar tab -->
        <Style Selector="Border.subTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.subTab">
            <Setter Property="Background" Value="#0a0a0a"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.subTab">
            <Setter Property="Background" Value="#0f7a45"/>
        </Style>

        <!-- Browser address bar -->
        <Style Selector="TextBox.addressBar">
            <Setter Property="Background" Value="#030303"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Foreground" Value="#c9d7d0"/>
            <Setter Property="CaretBrush" Value="#c9d7d0"/>
            <Setter Property="SelectionBrush" Value="#3c3c3c"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox.addressBar:focus">
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>
        <Style Selector="Border.browserButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#080808"/>
        </Style>
        <Style Selector="Button:pointerover Border.browserButton">
            <Setter Property="Background" Value="#0d4f32"/>
        </Style>

        <!-- Database explorer -->
        <Style Selector="Border.dbListItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.dbListItem">
            <Setter Property="Background" Value="#0f1a14"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.dbListItem">
            <Setter Property="Background" Value="#0f7a45"/>
        </Style>
        <Style Selector="TextBox.sqlEditor">
            <Setter Property="Background" Value="#030303"/>
            <Setter Property="BorderBrush" Value="#184820"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Foreground" Value="#d3eadf"/>
            <Setter Property="CaretBrush" Value="#d3eadf"/>
            <Setter Property="SelectionBrush" Value="#0f7a45"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="96"/>
        </Style>
        <Style Selector="TextBox.sqlEditor:focus">
            <Setter Property="BorderBrush" Value="#2ea05f"/>
        </Style>
        <Style Selector="Button.dbRunButton">
            <Setter Property="Background" Value="#0f7a45"/>
            <Setter Property="Foreground" Value="#f5fbf7"/>
            <Setter Property="BorderBrush" Value="#2ea05f"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.dbRunButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#13a35d"/>
        </Style>
        <Style Selector="TextBox.dbCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#c2d2ca"/>
            <Setter Property="CaretBrush" Value="#c2d2ca"/>
            <Setter Property="SelectionBrush" Value="#0f7a45"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>
        <Style Selector="Border.dbHeaderCell">
            <Setter Property="BorderBrush" Value="#2b2b2b"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="Border.dbDataCell">
            <Setter Property="BorderBrush" Value="#2b2b2b"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Background" Value="#050505"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="Border.metricsSummaryCard">
            <Setter Property="Background" Value="#060806"/>
            <Setter Property="BorderBrush" Value="#184820"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="MinHeight" Value="92"/>
        </Style>
        <Style Selector="Border.metricsChartCard">
            <Setter Property="Background" Value="#040604"/>
            <Setter Property="BorderBrush" Value="#184820"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <!-- Workspace entry: normal / hover / selected -->
        <Style Selector="Border.wsEntry">
            <Setter Property="Background" Value="#050505"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.wsEntry">
            <Setter Property="Background" Value="#0f5a38"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.wsEntry">
            <Setter Property="Background" Value="#0f7a45"/>
        </Style>

        <!-- Collapsed avatar: highlight selected -->
        <Style Selector="Border.wsAvatar">
            <Setter Property="Background" Value="#050505"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.wsAvatar">
            <Setter Property="Background" Value="#0f5a38"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.wsAvatar">
            <Setter Property="Background" Value="#0f7a45"/>
        </Style>

        <Style Selector="Button.wsDeleteButton">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="Button.wsDeleteButton:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Border.wsLifecycleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#080808"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button:pointerover Border.wsLifecycleButton">
            <Setter Property="Background" Value="#0d4f32"/>
        </Style>
        <Style Selector="Button:disabled Border.wsLifecycleButton">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="TextBlock.wsLifecycleIcon">
            <Setter Property="Foreground" Value="#f5fbf7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.wsLifecycleIconPlay">
            <Setter Property="Margin" Value="1,0,0,0"/>
        </Style>

        <!-- iOS-style toggle -->
        <Style Selector="ToggleButton.iosToggle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#444"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border CornerRadius="11"
                                Background="{TemplateBinding Background}"
                                Width="40" Height="22">
                            <Border x:Name="Thumb"
                                    CornerRadius="9"
                                    Width="18" Height="18"
                                    Background="#e0e0e0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.iosToggle:checked">
            <Setter Property="Background" Value="#00d66b"/>
        </Style>
        <Style Selector="ToggleButton.iosToggle:checked /template/ Border#Thumb">
            <Setter Property="Margin" Value="20,0,0,0"/>
        </Style>

        <!-- Add workspace (+) -->
        <Style Selector="Border.wsAddButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#080808"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button:pointerover Border.wsAddButton">
            <Setter Property="Background" Value="#0d4f32"/>
        </Style>
        <Style Selector="TextBlock.wsAddIcon">
            <Setter Property="Foreground" Value="#2bf27a"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Git changes panel -->
        <Style Selector="Border.gitNodeRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style Selector="Border.gitNodeRow:pointerover">
            <Setter Property="Background" Value="#0f3d28"/>
        </Style>
        <Style Selector="Button.gitNodeName">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- First-run tutorial -->
        <Style Selector="Border.tutorialButton">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#0f7a45"/>
        </Style>
        <Style Selector="Button:pointerover Border.tutorialButton">
            <Setter Property="Background" Value="#22e17b"/>
        </Style>
        <Style Selector="Button:disabled Border.tutorialButton">
            <Setter Property="Background" Value="#202020"/>
        </Style>
        <Style Selector="Border.tutorialSecondaryButton">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#080808"/>
            <Setter Property="BorderBrush" Value="#3c3c3c"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button:pointerover Border.tutorialSecondaryButton">
            <Setter Property="Background" Value="#0d4f32"/>
        </Style>
        <Style Selector="TextBlock.tutorialButtonText">
            <Setter Property="Foreground" Value="#f5fbf7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Styles>

    <Border Background="#000000"
            BorderThickness="0">
    <Grid RowDefinitions="42,*">

        <Control x:Name="FocusSink"
                 Width="1"
                 Height="1"
                 Opacity="0"
                 Focusable="True"
                 IsHitTestVisible="False"/>

        <!-- Integrated window controls / drag surface -->
        <Border Grid.Row="0"
                x:Name="WindowChrome"
                Background="#000000"
                BorderThickness="0"
                PointerPressed="OnWindowChromePointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding Chrome.LeftItems}"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image Source="avares://AgentUp.Desktop/media/logo.png"
                           Width="18"
                           Height="18"
                           Stretch="Uniform"/>
                    <TextBlock Text="Agent-Up"
                               Foreground="#f5fbf7"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="ValidationToggleButton"
                            Command="{Binding ToggleValidationCommand}"
                            ToolTip.Tip="Open validation checks">
                        <Border Classes="titleToolButton">
                            <TextBlock Classes="chromeIcon" Text="✓" FontSize="16"/>
                        </Border>
                    </Button>
                    <Button x:Name="MinimizeWindowButton"
                            Click="OnMinimizeWindowClicked"
                            ToolTip.Tip="Minimize">
                        <Border Classes="chromeButton">
                            <TextBlock Classes="chromeIcon chromeMinimizeIcon" Text="─"/>
                        </Border>
                    </Button>
                    <Button x:Name="RestoreWindowButton"
                            Click="OnRestoreWindowClicked"
                            ToolTip.Tip="Restore">
                        <Border Classes="chromeButton">
                            <TextBlock Classes="chromeIcon chromeRestoreIcon" Text="□"/>
                        </Border>
                    </Button>
                    <Button x:Name="CloseWindowButton"
                            Click="OnCloseWindowClicked"
                            ToolTip.Tip="Close">
                        <Border Classes="chromeButton chromeClose">
                            <TextBlock Classes="chromeIcon chromeCloseIcon" Text="×"/>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              x:Name="PageHost">
            <Panel x:Name="LoginPage"
                   IsVisible="{Binding Login.IsVisible}"
                   IsHitTestVisible="{Binding Login.IsVisible}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Background="#000000">
                <Grid RowDefinitions="*,Auto,*"
                      ColumnDefinitions="*,Auto,*">
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Width="420"
                            Background="#050505"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="32">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Agent-Up Server"
                                       Foreground="#f5fbf7"
                                       FontSize="25"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Enter the administrator password to continue."
                                       Foreground="#c6ddd2"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding !Login.IsConnectionRetry}"/>
                            <TextBlock Text="Could not reach the server. Check that Agent-Up Server is running and AGENTUP_SERVER_URL is correct."
                                       Foreground="#c6ddd2"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Login.IsConnectionRetry}"/>
                            <TextBox Text="{Binding Login.Password, Mode=TwoWay}"
                                     PasswordChar="●"
                                     PlaceholderText="Admin password"
                                     IsVisible="{Binding !Login.IsConnectionRetry}"/>
                            <Button Command="{Binding Login.RetryConnectionCommand}"
                                    IsVisible="{Binding Login.IsConnectionRetry}"
                                    HorizontalAlignment="Stretch">
                                <Border Background="#00b850"
                                        CornerRadius="6"
                                        Padding="12,8">
                                    <TextBlock Text="Retry connection"
                                               Foreground="#000000"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Button>
                            <Button Command="{Binding Login.SignInCommand}"
                                    IsEnabled="{Binding !Login.IsBusy}"
                                    IsVisible="{Binding !Login.IsConnectionRetry}"
                                    HorizontalAlignment="Stretch">
                                <Border Background="#00b850"
                                        CornerRadius="6"
                                        Padding="12,8">
                                    <TextBlock Text="Sign in"
                                               Foreground="#000000"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </Button>
                            <TextBlock Text="{Binding Login.ErrorMessage}"
                                       Foreground="#ff6b6b"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding Login.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Panel>

            <Grid IsVisible="{Binding !Login.IsVisible}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <!-- ── Sidebar ───────────────────────────────────────────────────────── -->
        <Border Grid.Column="0"
                x:Name="SidebarRail"
                Width="{Binding Sidebar.Width}"
                Background="#000000"
                BorderBrush="#2b2b2b"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Header (expanded only) -->
                <Border DockPanel.Dock="Top"
                        Padding="16,10,10,6"
                        IsVisible="{Binding Sidebar.IsExpanded}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="Workspaces"
                                   Foreground="#2bf27a"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                x:Name="AddWorkspaceButton"
                                Command="{Binding Sidebar.ShowAddWorkspaceCommand}"
                                ToolTip.Tip="Clone a repository into a new workspace">
                            <Border Classes="wsAddButton">
                                <TextBlock Classes="wsAddIcon" Text="+"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <!-- Add button above the avatar list (collapsed only) -->
                <Border DockPanel.Dock="Top"
                        Padding="0,10,0,6"
                        IsVisible="{Binding Sidebar.IsCollapsed}">
                    <Button x:Name="AddWorkspaceButtonCollapsed"
                            HorizontalAlignment="Center"
                            Command="{Binding Sidebar.ShowAddWorkspaceCommand}"
                            ToolTip.Tip="Clone a repository into a new workspace">
                        <Border Classes="wsAddButton">
                            <TextBlock Classes="wsAddIcon" Text="+"/>
                        </Border>
                    </Button>
                </Border>

                <!-- Expanded workspace list -->
                <ScrollViewer x:Name="WorkspaceListExpanded"
                              IsVisible="{Binding Sidebar.IsExpanded}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox HorizontalAlignment="Stretch"
                             Width="{Binding #SidebarRail.Bounds.Width}"
                             ItemsSource="{Binding Sidebar.Workspaces}"
                             SelectedItem="{Binding Sidebar.SelectedWorkspace}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:WorkspaceItemViewModel">
                                <Border Padding="10,2"
                                        HorizontalAlignment="Stretch">
                                    <Border Classes="wsEntry"
                                            CornerRadius="8"
                                            Padding="10,10,14,10"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="{Binding RepositoryToolTip}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Button Grid.Column="0"
                                                    Command="{Binding StartCommand}"
                                                    IsVisible="{Binding ShowStartButton}"
                                                    IsEnabled="{Binding !IsLifecycleBusy}"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Start workspace">
                                                <Border Classes="wsLifecycleButton">
                                                    <TextBlock Classes="wsLifecycleIcon wsLifecycleIconPlay"
                                                               Text="▶"/>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="0"
                                                    Command="{Binding StopCommand}"
                                                    IsVisible="{Binding ShowStopButton}"
                                                    IsEnabled="{Binding !IsLifecycleBusy}"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Stop workspace">
                                                <Border Classes="wsLifecycleButton">
                                                    <TextBlock Classes="wsLifecycleIcon" Text="■"/>
                                                </Border>
                                            </Button>
                                            <Grid Grid.Column="1">
                                                <StackPanel Spacing="3">
                                                    <DockPanel LastChildFill="True">
                                                        <Border DockPanel.Dock="Left"
                                                                Width="6" Height="6"
                                                                CornerRadius="3"
                                                                Background="{Binding StateColor}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="#f5fbf7"
                                                                   FontSize="15"
                                                                   FontWeight="Medium"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Branch}"
                                                               Foreground="#9fb2a8"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="13,0,0,0"/>
                                                </StackPanel>
                                                <Button Classes="wsDeleteButton"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-2,-2,0"
                                                        Command="{Binding RequestDeleteCommand}"
                                                        ToolTip.Tip="Remove workspace">
                                                    <TextBlock Text="✕"
                                                               Foreground="#d84f4f"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Collapsed avatar list -->
                <ScrollViewer x:Name="WorkspaceListCollapsed"
                              IsVisible="{Binding Sidebar.IsCollapsed}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox
                             ItemsSource="{Binding Sidebar.Workspaces}"
                             SelectedItem="{Binding Sidebar.SelectedWorkspace}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:WorkspaceItemViewModel">
                                <Border HorizontalAlignment="Center" Padding="0,4">
                                    <Border Classes="wsAvatar"
                                            Width="36" Height="36"
                                            CornerRadius="18"
                                            ToolTip.Tip="{Binding DisplayName}">
                                        <TextBlock Text="{Binding Initials}"
                                                   Foreground="#f5fbf7"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ── Main content ───────────────────────────────────────────────────── -->
        <Border Grid.Column="1" Background="#000000">
            <Panel>

                <!-- Loading -->
                <TextBlock x:Name="LoadingIndicator"
                           IsVisible="{Binding Sidebar.IsLoading}"
                           Text="Connecting to server…"
                           Foreground="#2bf27a"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Error -->
                <Panel x:Name="ErrorPanel"
                       IsVisible="{Binding Sidebar.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#140f0f"
                            BorderBrush="#552d2d"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24,20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding Sidebar.ErrorMessage}"
                                       Foreground="#e48989"
                                       FontSize="13"/>
                            <Button Command="{Binding Sidebar.RefreshCommand}"
                                    HorizontalAlignment="Center">
                                <Border Background="#0f7a45" CornerRadius="7" Padding="14,7">
                                    <TextBlock Text="Retry" Foreground="#f5fbf7" FontSize="12"/>
                                </Border>
                            </Button>
                        </StackPanel>
                    </Border>
                </Panel>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState"
                            IsVisible="{Binding Sidebar.ShowEmptyState}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <TextBlock Text="No workspaces registered"
                               Foreground="#2bf27a"
                               FontSize="16"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Run  agent-up register  in your project directory to get started."
                               Foreground="#789085"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Workspace detail: app tabs + sub-navbar + content -->
                <Border x:Name="WorkspaceDetail"
                        IsVisible="{Binding Sidebar.SelectedWorkspace, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">

                        <!-- Application tab bar -->
                        <Border Grid.Row="0"
                                Background="#050505"
                                BorderBrush="#2b2b2b"
                                BorderThickness="0,0,0,1">
                            <ListBox x:Name="ApplicationTabs"
                                     ItemsSource="{Binding Applications.Applications}"
                                     SelectedItem="{Binding Applications.SelectedApplication}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="appVm:ApplicationViewModel">
                                        <Border Classes="appTab" Padding="18,13">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Width="6" Height="6" CornerRadius="3"
                                                        Background="{Binding StateColor}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#c2d2ca"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Sub-navbar: Console + port tabs for the selected app -->
                        <Border Grid.Row="1"
                                IsVisible="{Binding Applications.SelectedApplication, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Background="#000000"
                                BorderBrush="#2b2b2b"
                                BorderThickness="0,0,0,1"
                                Padding="14,8">
                            <ListBox x:Name="SubNavBar"
                                     ItemsSource="{Binding SubTabs}"
                                     SelectedItem="{Binding SelectedSubTab}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <!-- Templates resolved from Window.DataTemplates by type -->
                            </ListBox>
                        </Border>

                        <!-- Browser address bar for HTTP port tabs -->
                        <Border Grid.Row="2"
                                x:Name="AddressNavBar"
                                IsVisible="{Binding ShowPortView}"
                                Background="#000000"
                                BorderBrush="#2b2b2b"
                                BorderThickness="0,0,0,1"
                                Padding="16,7">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                                  ColumnSpacing="6">
                                <Button Grid.Column="0"
                                        x:Name="BrowserBackButton"
                                        Command="{Binding BrowserBackCommand}"
                                        ToolTip.Tip="Back">
                                    <Border Classes="browserButton">
                                        <TextBlock Text="‹"
                                                   Foreground="#d3eadf"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button Grid.Column="1"
                                        x:Name="BrowserForwardButton"
                                        Command="{Binding BrowserForwardCommand}"
                                        ToolTip.Tip="Forward">
                                    <Border Classes="browserButton">
                                        <TextBlock Text="›"
                                                   Foreground="#d3eadf"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <Button Grid.Column="2"
                                        x:Name="BrowserReloadButton"
                                        Command="{Binding BrowserReloadCommand}"
                                        ToolTip.Tip="Reload">
                                    <Border Classes="browserButton">
                                        <TextBlock Text="↺"
                                                   Foreground="#d3eadf"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Button>
                                <TextBox Grid.Column="3"
                                         x:Name="AddressBar"
                                         Classes="addressBar"
                                         Text="{Binding AddressBarUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Stretch">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter"
                                                    Command="{Binding NavigateAddressCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- Content area -->
                        <Panel Grid.Row="3">

                            <!-- No applications configured -->
                            <StackPanel IsVisible="{Binding Applications.SelectedApplication, Converter={x:Static ObjectConverters.IsNull}}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <TextBlock Text="No apps in this workspace"
                                           Foreground="#6f857a"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Add an agent-up.json with an applications list."
                                           Foreground="#52685d"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Console output — populated by code-behind with a NativeWebView -->
                            <Grid IsVisible="{Binding ShowConsole}"
                                  RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0"
                                           IsVisible="{Binding Console.WasTruncated}"
                                           Text="Server output was capped at 50,000 lines."
                                           Foreground="#789085"
                                           FontSize="11"
                                           Margin="20,8,20,0"/>
                                <Panel x:Name="ConsolePane" Grid.Row="1" />
                                <StackPanel Grid.Row="2"
                                            IsVisible="{Binding Console.HasHiddenLines}"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            Margin="20,6,20,6">
                                    <TextBlock Foreground="#789085"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Text="Showing last 2,000 lines."/>
                                    <Button Command="{Binding Console.ShowMoreCommand}"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            Foreground="#0f7a45"
                                            FontSize="11"
                                            Cursor="Hand"
                                            Content="Show all"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="AuditPanel" IsVisible="{Binding ShowAudit}" RowDefinitions="*,Auto">
                                <ListBox x:Name="AuditEventList" Grid.Row="0" ItemsSource="{Binding Audit.Events}" Margin="16,12">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#163923" BorderThickness="0,0,0,1" Padding="10,9">
                                                <Grid ColumnDefinitions="150,150,*" ColumnSpacing="12">
                                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="#789085" FontSize="11"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Action}" Foreground="#f5fbf7" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding Outcome}" Foreground="#00b850" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="#aebcb3" FontSize="11" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="AuditLoadMoreButton" Grid.Row="1" IsVisible="{Binding Audit.HasMore}" Command="{Binding Audit.LoadMoreCommand}" Margin="20,8" HorizontalAlignment="Left">
                                    <Border Classes="tutorialSecondaryButton"><TextBlock Text="Load older events" Foreground="#f5fbf7" FontSize="11"/></Border>
                                </Button>
                            </Grid>

                            <!-- Port view: browser WebViews are added/swapped here in code-behind -->
                            <Panel x:Name="PortPane"
                                   IsVisible="{Binding ShowPortView}">
                                <!-- Shown only when NativeWebView creation fails for the active workspace -->
                                <Border x:Name="WebViewErrorBanner"
                                        IsVisible="False"
                                        ZIndex="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#140f0f"
                                        BorderBrush="#552d2d"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="24,20">
                                    <TextBlock x:Name="WebViewErrorText"
                                               Foreground="#e48989"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               MaxWidth="400"/>
                                </Border>
                            </Panel>

                            <!-- TCP port placeholder -->
                            <StackPanel IsVisible="{Binding ShowTcpInfo}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <TextBlock Text="TCP port"
                                           Foreground="#6f857a"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="This port is not an HTTP service."
                                           Foreground="#52685d"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Database explorer -->
                            <Grid IsVisible="{Binding ShowDatabase}"
                                  ColumnDefinitions="220,*"
                                  Margin="16,12">
                                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,*" RowSpacing="8" Margin="0,0,12,0">
                                    <TextBlock Grid.Row="0"
                                               Text="Databases"
                                               Foreground="#8aa497"
                                               FontSize="12"
                                               FontWeight="Medium"/>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding Database.Databases}"
                                             SelectedItem="{Binding Database.SelectedDatabase}"
                                             Background="#050505"
                                             BorderBrush="#2b2b2b"
                                             BorderThickness="1"
                                             Padding="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="dbListItem" Padding="10,8" Margin="0,1">
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="#c2d2ca"
                                                               FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="2"
                                               Text="Tables"
                                               Foreground="#8aa497"
                                               FontSize="12"
                                               FontWeight="Medium"/>
                                    <ListBox Grid.Row="3"
                                             ItemsSource="{Binding Database.Tables}"
                                             SelectedItem="{Binding Database.SelectedTable}"
                                             Background="#050505"
                                             BorderBrush="#2b2b2b"
                                             BorderThickness="1"
                                             Padding="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="dbListItem" Padding="10,8" Margin="0,1">
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="#c2d2ca"
                                                               FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right"
                                                Classes="dbRunButton"
                                                Content="Run"
                                                Command="{Binding Database.RunQueryCommand}"
                                                Margin="8,0,0,0"/>
                                        <TextBox Classes="sqlEditor"
                                                 Text="{Binding Database.SqlQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 PlaceholderText="SQL query"/>
                                    </DockPanel>

                                    <Border Grid.Row="1"
                                            Background="#1a0d0d"
                                            BorderBrush="#5a2b2b"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,0,0,8"
                                            IsVisible="{Binding Database.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding Database.ErrorMessage}"
                                                   Foreground="#f0a8a8"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   FontSize="11"/>
                                    </Border>

                                    <ScrollViewer Grid.Row="2"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  IsVisible="{Binding Database.HasResults}">
                                        <StackPanel Spacing="0">
                                            <ItemsControl ItemsSource="{Binding Database.Columns}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="dbHeaderCell"
                                                                Width="{Binding Width}">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#d3eadf"
                                                                       FontWeight="Bold"
                                                                       FontSize="11"
                                                                       FontFamily="Consolas,Courier New,monospace"
                                                                       TextWrapping="NoWrap"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding Database.Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="databaseViewsVm:DatabaseRowViewModel">
                                                        <ItemsControl ItemsSource="{Binding Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Classes="dbDataCell"
                                                                            Width="{Binding Width}">
                                                                        <TextBox Classes="dbCell"
                                                                                 Text="{Binding Value}"
                                                                                 TextWrapping="NoWrap"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <StackPanel Grid.Row="2"
                                                IsVisible="{Binding Database.ShowEmptyState}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <TextBlock Text="Select a table or run a query."
                                                   Foreground="#6f857a"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                IsVisible="{Binding Database.IsLoading}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <TextBlock Text="Loading database..."
                                                   Foreground="#6f857a"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Metrics dashboard -->
                            <Grid IsVisible="{Binding ShowMetrics}"
                                  RowDefinitions="Auto,*">
                                <DockPanel Grid.Row="0" Margin="20,14,20,0" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Metrics.LastUpdated}"
                                               Foreground="#52685d"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Application metrics"
                                               Foreground="#8aa497"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <ScrollViewer Grid.Row="1"
                                              Margin="20,12,20,20"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="18">
                                        <ItemsControl ItemsSource="{Binding Metrics.SummaryCards}"
                                                      IsVisible="{Binding Metrics.HasSummary}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Metrics.Charts}"
                                                      IsVisible="{Binding Metrics.HasCharts}"/>

                                        <StackPanel IsVisible="{Binding Metrics.IsLoading}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="8"
                                                    Margin="0,40,0,0">
                                            <TextBlock Text="Loading metrics..."
                                                       Foreground="#6f857a"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel IsVisible="{Binding Metrics.ShowEmptyState}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="8"
                                                    Margin="0,40,0,0">
                                            <TextBlock Text="{Binding Metrics.EmptyMessage}"
                                                       Foreground="#6f857a"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       MaxWidth="420"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                        </Panel>

                    </Grid>
                </Border>

            </Panel>
        </Border>

        <Border x:Name="ValidationPanel" Grid.Column="2" Width="360" Background="#050706" BorderBrush="#2b2b2b" BorderThickness="1,0,0,0" IsVisible="{Binding IsValidationOpen}" Padding="18">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <DockPanel><TextBlock Text="Validation" Foreground="#2bf27a" FontSize="18" FontWeight="Bold"/><Button DockPanel.Dock="Right" Command="{Binding ToggleValidationCommand}"><TextBlock Text="×" Foreground="#f5fbf7" FontSize="20"/></Button></DockPanel>
                <TextBlock Grid.Row="1" Text="Behavioral checks for the selected application" Foreground="#9fb2a8" FontSize="12"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10">
                    <TextBlock Text="{Binding Validation.Status}"
                               Foreground="#9fb2a8"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Validation.Status, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <ItemsControl x:Name="ValidationFlowList" ItemsSource="{Binding Validation.Flows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="validationVm:ValidationFlowItemViewModel">
                                <Border Background="#0a0d0b" BorderBrush="#304039" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StatusGlyph}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Width="18"
                                                       VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Name}" Foreground="#f5fbf7" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#aebcb3" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding InitialPath, StringFormat='Starts at {0}'}" Foreground="#789085" FontSize="11"/>
                                                <TextBlock Text="{Binding ResultMessage}"
                                                           Foreground="#9fb2a8"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasRunResult}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Command="{Binding RunCommand}"
                                                    IsEnabled="{Binding !IsRunning}"
                                                    VerticalAlignment="Top">
                                                <Border Background="#0f7a45" CornerRadius="6" Padding="12,7">
                                                    <TextBlock Text="▶ Play" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                            </Button>
                                        </Grid>

                                        <StackPanel Spacing="6"
                                                    IsVisible="{Binding IsExpanded}"
                                                    Margin="26,0,0,0">
                                            <ItemsControl ItemsSource="{Binding Stages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="validationVm:ValidationStageViewModel">
                                                        <StackPanel Spacing="4" Margin="0,0,0,8">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding StatusGlyph}"
                                                                           Foreground="{Binding StatusColor}"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           Width="14"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Title}"
                                                                           Foreground="#f5fbf7"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"/>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Checks}" Margin="18,0,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="validationVm:ValidationCheckViewModel">
                                                                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,3">
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding StatusGlyph}"
                                                                                       Foreground="{Binding StatusColor}"
                                                                                       FontSize="11"
                                                                                       FontWeight="Bold"
                                                                                       Width="14"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Label}"
                                                                                       Foreground="#aebcb3"
                                                                                       FontSize="11"
                                                                                       TextWrapping="Wrap"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel></ScrollViewer>
            </Grid>
        </Border>

        <!-- ── Git changes panel ──────────────────────────────────────────────── -->
        <Border Grid.Column="2"
                x:Name="GitPanel"
                Width="320"
                IsVisible="{Binding Git.IsVisible}"
                Background="#000000"
                BorderBrush="#2b2b2b"
                BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <Border Grid.Row="0" Padding="14,12,10,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Git changes"
                                       Foreground="#2bf27a"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="GitBranchLabel"
                                       Text="{Binding Git.Branch}"
                                       Foreground="#9fb2a8"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="GitRefreshButton"
                                Command="{Binding Git.RefreshCommand}"
                                ToolTip.Tip="Reload Git changes">
                            <Border Classes="titleToolButton">
                                <TextBlock Classes="chromeIcon" Text="↺" FontSize="14"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="14,0,14,8" Spacing="4">
                    <TextBlock x:Name="GitSelectionSummary"
                               Text="{Binding Git.SelectionSummary}"
                               Foreground="#789085"
                               FontSize="11"/>
                    <TextBlock x:Name="GitErrorMessage"
                               Text="{Binding Git.ErrorMessage}"
                               IsVisible="{Binding Git.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="#d84f4f"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="GitStatusMessage"
                               Text="{Binding Git.StatusMessage}"
                               IsVisible="{Binding Git.StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="#2bf27a"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Panel Grid.Row="2">
                    <ScrollViewer x:Name="GitChangeTree"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="8,0">
                        <ItemsControl ItemsSource="{Binding Git.Nodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="gitVm:GitChangeNodeViewModel">
                                    <Border Classes="gitNodeRow" Margin="{Binding Indent}">
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      MinWidth="0"
                                                      Padding="0"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Glyph}"
                                                       Foreground="{Binding GlyphColor}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Width="14"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Classes="gitNodeName"
                                                    Command="{Binding OpenCommand}"
                                                    IsEnabled="{Binding IsFile}"
                                                    ToolTip.Tip="{Binding ToolTip}">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{Binding NameColor}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="GitLoadingIndicator"
                               IsVisible="{Binding Git.IsLoading}"
                               Text="Loading changes…"
                               Foreground="#2bf27a"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="GitEmptyState"
                               IsVisible="{Binding Git.ShowEmptyState}"
                               Text="No uncommitted changes."
                               Foreground="#6f857a"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Panel>

                <StackPanel Grid.Row="3" Margin="14,8,14,14" Spacing="8">
                    <TextBox x:Name="GitCommitMessage"
                             Text="{Binding Git.CommitMessage}"
                             Watermark="Commit message"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="72"
                             MaxHeight="140"
                             Background="#050505"
                             Foreground="#f5fbf7"
                             BorderBrush="#333333"
                             BorderThickness="1"
                             FontSize="12"/>
                    <Button x:Name="GitCommitButton"
                            HorizontalAlignment="Stretch"
                            Command="{Binding Git.CommitCommand}">
                        <Border Classes="tutorialButton" HorizontalAlignment="Stretch">
                            <TextBlock Classes="tutorialButtonText"
                                       Text="Commit"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>
        </Grid>

        <Grid x:Name="FirstRunTutorialOverlay"
              ZIndex="90"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsVisible="{Binding Tutorial.IsVisible}"
              IsHitTestVisible="{Binding Tutorial.IsVisible}">
            <Border Background="#CC020806"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            <Border Background="#6607110f"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border.Effect>
                    <BlurEffect Radius="10"/>
                </Border.Effect>
            </Border>

            <Grid RowDefinitions="*,8*,*"
                  ColumnDefinitions="*,8*,*">
            <Border Grid.Row="1"
                    Grid.Column="1"
                    MinWidth="480"
                    MinHeight="320"
                    MaxWidth="900"
                    MaxHeight="620"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#050505"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="6">
                        <TextBlock Text="Agent-Up first run"
                                   Foreground="#f5fbf7"
                                   FontSize="28"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Set up a complete two-workspace JavaScript demo before entering the app."
                                   Foreground="#acd0bd"
                                   FontSize="15"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,22,0,22"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            <StackPanel IsVisible="{Binding Tutorial.ShowDockerStep}" Spacing="16">
                                <TextBlock Text="Step 1: Install Docker and Agent-Up"
                                           Foreground="#f5fbf7"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#c6ddd2"
                                           FontSize="15">
                                    <Run Text="Agent-Up needs "/>
                                    <Run Text="Docker" FontWeight="Bold" Foreground="#f5fbf7"/>
                                    <Run Text=" for database services and "/>
                                    <Run Text="Agent-Up CLI" FontWeight="Bold" Foreground="#f5fbf7"/>
                                    <Run Text=" to register workspaces with the Server."/>
                                </TextBlock>
                                <Button x:Name="TutorialCheckPrerequisitesButton"
                                        Command="{Binding Tutorial.CheckDockerCommand}"
                                        HorizontalAlignment="Left">
                                    <Border Classes="tutorialSecondaryButton">
                                        <TextBlock Classes="tutorialButtonText" Text="Check Prerequisites"/>
                                    </Border>
                                </Button>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowEnvironmentStep}" Spacing="16">
                                <TextBlock Text="Step 2: Choose a development environment"
                                           Foreground="#f5fbf7"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#c6ddd2"
                                           FontSize="15">
                                    <Run Text="Choose the stack Agent-Up should prove end-to-end. The JavaScript path builds a "/>
                                    <Run Text="real React + Express + Postgres workspace" FontWeight="Bold" Foreground="#f5fbf7"/>
                                    <Run Text=", then duplicates it to prove port isolation."/>
                                </TextBlock>
                                <Grid ColumnDefinitions="*,*,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="12">
                                    <Button Grid.Column="0"
                                            x:Name="TutorialSelectJavaScriptButton"
                                            Command="{Binding Tutorial.SelectJavaScriptCommand}">
                                        <Border Background="#080808" BorderBrush="#3c3c3c" BorderThickness="1" CornerRadius="8" Padding="16">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="JS"
                                                           Foreground="#f4dd4b"
                                                           FontSize="30"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Node + JavaScript" Foreground="#f5fbf7" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="React SPA, Express API, Postgres" Foreground="#acd0bd" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Border Grid.Column="1" Background="#050505" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16" Opacity="0.62">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text=".NET" Foreground="#8bb7ff" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text=".NET" Foreground="#f5fbf7" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Coming later" Foreground="#acd0bd" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#050505" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="16" Opacity="0.62">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="PY" Foreground="#ffd66b" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Python" Foreground="#f5fbf7" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Coming later" Foreground="#acd0bd" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowNodeStep}" Spacing="16">
                                <TextBlock Text="Step 3: Install Node.js 20+"
                                           Foreground="#f5fbf7"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#c6ddd2"
                                           FontSize="15">
                                    <Run Text="The sample apps run on "/>
                                    <Run Text="Node.js 20 or newer" FontWeight="Bold" Foreground="#f5fbf7"/>
                                    <Run Text=" with npm. If you install Node while Agent-Up Desktop is open, restart Desktop so it receives the updated PATH."/>
                                </TextBlock>
                                <Button x:Name="TutorialCheckNodeButton"
                                        Command="{Binding Tutorial.CheckNodeCommand}"
                                        HorizontalAlignment="Left">
                                    <Border Classes="tutorialSecondaryButton">
                                        <TextBlock Classes="tutorialButtonText" Text="Check Node"/>
                                    </Border>
                                </Button>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowSampleStep}" Spacing="16">
                                <TextBlock Text="Step 4: Create project files"
                                           Foreground="#f5fbf7"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#c6ddd2"
                                           FontSize="15">
                                    <Run Text="Agent-Up Desktop creates "/>
                                    <Run Text="example-agent1" FontWeight="Bold" Foreground="#f5fbf7"/>
                                    <Run Text=" under /tmp/&lt;random-guid&gt;/agent-up-tutorial/ with a React app, an Express API, and docker-compose.yaml for Postgres."/>
                                </TextBlock>
                                <Button x:Name="TutorialCreateProjectFilesButton"
                                        Command="{Binding Tutorial.CreateSampleProjectCommand}"
                                        HorizontalAlignment="Left">
                                    <Border Classes="tutorialSecondaryButton">
                                        <TextBlock Classes="tutorialButtonText" Text="Create Project Files"/>
                                    </Border>
                                </Button>
                                <StackPanel IsVisible="{Binding Tutorial.ShowProjectFileCheckSection}"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Tutorial.ProjectDirectory}"
                                               Foreground="#d3eadf"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="These are the files Agent-Up will manage. The smoke check confirms the project shape is complete."
                                               Foreground="#acd0bd"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                    <TextBox IsVisible="{Binding Tutorial.ShowDirectoryTree}"
                                             Text="{Binding Tutorial.DirectoryTree}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="Consolas,Courier New,monospace"
                                             FontSize="12"
                                             MinHeight="130"
                                             Background="#000000"
                                             BorderBrush="#333333"
                                             Foreground="#dcf3e7"
                                             Padding="12"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="OpenTutorialFolderButton"
                                                Click="OnOpenTutorialFolderClicked">
                                            <Border Classes="tutorialSecondaryButton">
                                                <TextBlock Classes="tutorialButtonText" Text="Open File Explorer"/>
                                            </Border>
                                        </Button>
                                        <Button x:Name="TutorialCheckProjectFilesButton"
                                                Command="{Binding Tutorial.CheckProjectFilesCommand}">
                                            <Border Classes="tutorialSecondaryButton">
                                                <TextBlock Classes="tutorialButtonText" Text="Check Project Files"/>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowAgentUpJsonStep}" Spacing="16">
                                <TextBlock Text="Step 5: Create agent-up.json"
                                           Foreground="#f5fbf7"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#c6ddd2"
                                           FontSize="15">
                                    <Run Text="agent-up.json is the "/>
                                    <Run Text="contract between your project and Agent-Up" FontWeight="Bold" Foreground="#f5fbf7"/>
                                    <Run Text=". It declares the two Node apps and starts Postgres with docker compose."/>
                                </TextBlock>
                                <TextBox Text="{Binding Tutorial.Snippet}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas,Courier New,monospace"
                                         FontSize="12"
                                         MinHeight="220"
                                         Background="#000000"
                                         BorderBrush="#333333"
                                         Foreground="#dcf3e7"
                                         Padding="12"/>
                                <StackPanel Spacing="10" Margin="0,8,0,0">
                                    <TextBlock Text="Agent-Up Desktop writes this file for you, then checks it before continuing."
                                               Foreground="#acd0bd"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="TutorialCreateAgentUpJsonButton"
                                            HorizontalAlignment="Left"
                                            Command="{Binding Tutorial.CreateAgentUpJsonCommand}">
                                        <Border Classes="tutorialSecondaryButton">
                                            <TextBlock Classes="tutorialButtonText" Text="Create agent-up.json"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding Tutorial.ShowAgentUpJsonCheckSection}"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="Now check that agent-up.json exists and can be parsed."
                                               Foreground="#acd0bd"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="TutorialCheckAgentUpJsonButton"
                                            Command="{Binding Tutorial.CheckAgentUpJsonCommand}"
                                            HorizontalAlignment="Left">
                                        <Border Classes="tutorialSecondaryButton">
                                            <TextBlock Classes="tutorialButtonText" Text="Check agent-up.json"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowStartStep}" Spacing="16">
                                <TextBlock Text="Step 6: Start the workspace"
                                           Foreground="#f5fbf7"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#c6ddd2"
                                           FontSize="15">
                                    <Run Text="Starting the workspace registers it with the "/>
                                    <Run Text="Agent-Up Server" FontWeight="Bold" Foreground="#f5fbf7"/>
                                    <Run Text=", launches the declared apps, and assigns ports from the workspace range."/>
                                </TextBlock>
                                <StackPanel Spacing="10" Margin="0,8,0,0">
                                    <Button x:Name="TutorialStartWorkspaceButton"
                                            Command="{Binding Tutorial.StartWorkspaceCommand}"
                                            HorizontalAlignment="Left">
                                        <Border Classes="tutorialSecondaryButton">
                                            <TextBlock Classes="tutorialButtonText" Text="Run agent-up start"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding Tutorial.ShowCommandOutput}"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="Command output"
                                               Foreground="#acd0bd"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBox Text="{Binding Tutorial.CommandOutput}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas,Courier New,monospace"
                                             FontSize="12"
                                             MinHeight="120"
                                             Background="#000000"
                                             BorderBrush="#333333"
                                             Foreground="#dcf3e7"
                                             Padding="12"/>
                                </StackPanel>
                                <StackPanel IsVisible="{Binding Tutorial.ShowWorkspaceCheckSection}"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="The command succeeded. Now ask the Server whether it sees React, Express, and Postgres."
                                               Foreground="#acd0bd"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="TutorialCheckWorkspaceButton"
                                            Command="{Binding Tutorial.CheckWorkspaceCommand}"
                                            HorizontalAlignment="Left">
                                        <Border Classes="tutorialSecondaryButton">
                                            <TextBlock Classes="tutorialButtonText" Text="Check Workspace"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowDuplicateStep}" Spacing="16">
                                <TextBlock Text="Step 7: Duplicate the workspace"
                                           Foreground="#f5fbf7"
                                           FontSize="22"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#c6ddd2"
                                           FontSize="15">
                                    <Run Text="Now Agent-Up copies "/>
                                    <Run Text="example-agent1 to example-agent2" FontWeight="Bold" Foreground="#f5fbf7"/>
                                    <Run Text=" under the same tutorial root and starts it too. This proves two agents can run the same project without port collisions."/>
                                </TextBlock>
                                <Button x:Name="TutorialCreateDuplicateButton"
                                        Command="{Binding Tutorial.MarkDuplicateStartedCommand}"
                                        HorizontalAlignment="Left">
                                    <Border Classes="tutorialSecondaryButton">
                                        <TextBlock Classes="tutorialButtonText" Text="Create and Start example-agent2"/>
                                    </Border>
                                </Button>
                                <StackPanel IsVisible="{Binding Tutorial.ShowDuplicateCheckSection}"
                                            Spacing="10"
                                            Margin="0,8,0,0">
                                    <TextBlock Text="The duplicate has started. Check that both workspaces are registered and every allocated port is unique."
                                               Foreground="#acd0bd"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="TutorialCheckDuplicateButton"
                                            Command="{Binding Tutorial.CheckDuplicateCommand}"
                                            HorizontalAlignment="Left">
                                        <Border Classes="tutorialSecondaryButton">
                                            <TextBlock Classes="tutorialButtonText" Text="Check Duplicate"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Tutorial.ShowSuccessStep}" Spacing="16">
                                <TextBlock Text="You just proved the core Agent-Up workflow"
                                           Foreground="#f5fbf7"
                                           FontSize="24"
                                           FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#c6ddd2"
                                           FontSize="16">
                                    <Run Text="Agent-Up created "/>
                                    <Run Text="two isolated workspaces" FontWeight="Bold" Foreground="#f5fbf7"/>
                                    <Run Text=" from the same JavaScript project, started the same React, Express, and Postgres components in both, and let the Server allocate ports without collisions."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#c6ddd2"
                                           FontSize="16">
                                    <Run Text="The second workspace also has "/>
                                    <Run Text="different seeded product data" FontWeight="Bold" Foreground="#f5fbf7"/>
                                    <Run Text=", so the React dashboard table makes it obvious which isolated environment you are viewing."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#c6ddd2"
                                           FontSize="16">
                                    <Run Text="That matters because agents can now work in parallel on duplicate environments while sharing the same runtime rules: "/>
                                    <Run Text="workspace identity, process lifecycle, Docker, browser profiles, diagnostics, and ports all stay Server-owned." FontWeight="Bold" Foreground="#f5fbf7"/>
                                </TextBlock>
                            </StackPanel>

                            <Border IsVisible="{Binding Tutorial.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Background="#000000"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <TextBlock x:Name="TutorialStatusMessage"
                                           Text="{Binding Tutorial.StatusMessage}"
                                           Foreground="#d3eadf"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                          ColumnSpacing="10">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Tutorial.CurrentStep, StringFormat='Step {0} of 8'}"
                                   Foreground="#2bf27a"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Command="{Binding Tutorial.BackCommand}"
                                IsEnabled="{Binding Tutorial.CanGoBack}">
                            <Border Classes="tutorialSecondaryButton">
                                <TextBlock Classes="tutorialButtonText" Text="Back"/>
                            </Border>
                        </Button>
                        <Button Grid.Column="3"
                                x:Name="TutorialContinueButton"
                                Command="{Binding Tutorial.ContinueCommand}"
                                IsEnabled="{Binding Tutorial.CanContinue}">
                            <Border Classes="tutorialButton">
                                <TextBlock Classes="tutorialButtonText"
                                           Text="{Binding Tutorial.PrimaryButtonText}"/>
                            </Border>
                        </Button>
                        <Button Grid.Column="4"
                                x:Name="SkipTutorialButton"
                                Command="{Binding Tutorial.SkipCommand}">
                            <Border Classes="tutorialSecondaryButton">
                                <TextBlock Classes="tutorialButtonText" Text="Skip"/>
                            </Border>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <Grid ZIndex="100"
              x:Name="AddWorkspaceOverlay"
              IsVisible="{Binding Sidebar.AddWorkspace.IsVisible}"
              IsHitTestVisible="{Binding Sidebar.AddWorkspace.IsVisible}">
            <Border Background="#CC020806"/>
            <Border Background="#6607110f">
                <Border.Effect>
                    <BlurEffect Radius="10"/>
                </Border.Effect>
            </Border>

            <Grid RowDefinitions="*,8*,*"
                  ColumnDefinitions="*,8*,*">
                <Border Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="460"
                        MaxWidth="600"
                        VerticalAlignment="Center"
                        Background="#050505"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="28">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Add workspace"
                                       Foreground="#f5fbf7"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Agent-Up clones the repository into its managed source clones directory and registers the workspace."
                                       Foreground="#c6ddd2"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Repository"
                                       Foreground="#9fb2a8"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBox x:Name="AddWorkspaceRepository"
                                     Text="{Binding Sidebar.AddWorkspace.Repository}"
                                     Watermark="https://github.com/acme/widgets.git"
                                     IsEnabled="{Binding !Sidebar.AddWorkspace.IsBusy}"
                                     Background="#080808"
                                     Foreground="#f5fbf7"
                                     BorderBrush="#333333"
                                     BorderThickness="1"
                                     FontSize="13"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Branch"
                                       Foreground="#9fb2a8"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBox x:Name="AddWorkspaceBranch"
                                     Text="{Binding Sidebar.AddWorkspace.Branch}"
                                     Watermark="main"
                                     IsEnabled="{Binding !Sidebar.AddWorkspace.IsBusy}"
                                     Background="#080808"
                                     Foreground="#f5fbf7"
                                     BorderBrush="#333333"
                                     BorderThickness="1"
                                     FontSize="13"/>
                        </StackPanel>

                        <TextBlock x:Name="AddWorkspaceError"
                                   Text="{Binding Sidebar.AddWorkspace.ErrorMessage}"
                                   IsVisible="{Binding Sidebar.AddWorkspace.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Foreground="#d84f4f"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <Button Grid.Column="1"
                                    x:Name="AddWorkspaceCancelButton"
                                    Command="{Binding Sidebar.AddWorkspace.CancelCommand}">
                                <Border Classes="tutorialSecondaryButton">
                                    <TextBlock Classes="tutorialButtonText" Text="Cancel"/>
                                </Border>
                            </Button>
                            <Button Grid.Column="2"
                                    x:Name="AddWorkspaceConfirmButton"
                                    Command="{Binding Sidebar.AddWorkspace.ConfirmCommand}">
                                <Border Classes="tutorialButton">
                                    <TextBlock Classes="tutorialButtonText"
                                               Text="{Binding Sidebar.AddWorkspace.ConfirmLabel}"/>
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid ZIndex="100"
              x:Name="GitFileDiffOverlay"
              IsVisible="{Binding Git.Diff.IsVisible}"
              IsHitTestVisible="{Binding Git.Diff.IsVisible}">
            <Border Background="#CC020806"/>
            <Border Background="#6607110f">
                <Border.Effect>
                    <BlurEffect Radius="10"/>
                </Border.Effect>
            </Border>

            <Grid RowDefinitions="*,10*,*"
                  ColumnDefinitions="*,10*,*">
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Background="#050505"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock x:Name="GitFileDiffPath"
                                           Text="{Binding Git.Diff.Path}"
                                           Foreground="#f5fbf7"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="GitFileDiffStatus"
                                           Text="{Binding Git.Diff.Status}"
                                           Foreground="#9fb2a8"
                                           FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="GitFileDiffCloseButton"
                                    Command="{Binding Git.Diff.CloseCommand}"
                                    ToolTip.Tip="Close">
                                <Border Classes="chromeButton">
                                    <TextBlock Classes="chromeIcon chromeCloseIcon" Text="×"/>
                                </Border>
                            </Button>
                        </Grid>

                        <Panel Grid.Row="1">
                            <TextBlock IsVisible="{Binding Git.Diff.IsLoading}"
                                       Text="Loading diff…"
                                       Foreground="#2bf27a"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="GitFileDiffContent"
                                           Text="{Binding Git.Diff.Content}"
                                           Foreground="#c6ddd2"
                                           FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                           FontSize="12"/>
                            </ScrollViewer>
                        </Panel>

                        <Button Grid.Row="2"
                                x:Name="GitFileDiffDismissButton"
                                HorizontalAlignment="Right"
                                Command="{Binding Git.Diff.CloseCommand}">
                            <Border Classes="tutorialSecondaryButton">
                                <TextBlock Classes="tutorialButtonText" Text="Close"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid ZIndex="100"
              x:Name="WorkspaceDeleteOverlay"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsVisible="{Binding Sidebar.DeleteConfirmation.IsVisible}"
              IsHitTestVisible="{Binding Sidebar.DeleteConfirmation.IsVisible}">
            <Border Background="#CC020806"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            <Border Background="#6607110f"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border.Effect>
                    <BlurEffect Radius="10"/>
                </Border.Effect>
            </Border>

            <Grid RowDefinitions="*,8*,*"
                  ColumnDefinitions="*,8*,*">
                <Border Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="420"
                        MaxWidth="560"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#050505"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="28">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Remove workspace"
                                       Foreground="#f5fbf7"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding Sidebar.DeleteConfirmation.Message}"
                                       Foreground="#c6ddd2"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <CheckBox x:Name="WorkspaceDeleteConfirmCheckbox"
                                  Content="I understand this removes the workspace from Agent-Up"
                                  Foreground="#c6ddd2"
                                  FontSize="13"
                                  IsChecked="{Binding Sidebar.DeleteConfirmation.ConfirmChecked}"/>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <Button Grid.Column="1"
                                    x:Name="WorkspaceDeleteCancelButton"
                                    Command="{Binding Sidebar.DeleteConfirmation.CancelCommand}">
                                <Border Classes="tutorialSecondaryButton">
                                    <TextBlock Classes="tutorialButtonText" Text="Cancel"/>
                                </Border>
                            </Button>
                            <Button Grid.Column="2"
                                    x:Name="WorkspaceDeleteConfirmButton"
                                    Command="{Binding Sidebar.DeleteConfirmation.ConfirmCommand}">
                                <Border Classes="tutorialButton">
                                    <TextBlock Classes="tutorialButtonText" Text="Delete"/>
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
