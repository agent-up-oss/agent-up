<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ids="using:AgentUp.Desktop.Shared.Providers"
             x:Class="AgentUp.Desktop.Features.Interface.Views.CommandCenterView"
             x:CompileBindings="False"
             Background="{DynamicResource AgentUpColorCanvasBrush}">

    <!--
        The command center shell. Everything it draws comes from two reads the Server answers per
        workspace - the agent session and the forge - so the same page fills against the Demo and
        against a real Server without a demo-only path. Where a read said nothing, the surface says
        so rather than showing a number nothing produced.
    -->
    <UserControl.Resources>

        <!-- A triage row: who, what they are on, and what it needs. -->
        <DataTemplate x:Key="StandingRowTemplate">
            <Border Margin="0,0,0,8"
                    Padding="14,12"
                    CornerRadius="8"
                    Background="{DynamicResource AgentUpColorSurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="15"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AgentUpColorSurfaceBrush}"
                            BorderBrush="{DynamicResource AgentUpColorBorderStrongBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding Initial}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Headline}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding IdentityToolTip}"
                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                        <TextBlock Text="{Binding Reason}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasReason}"
                                   Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DiagnosticCode}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource AgentUpFontMono}"
                                   IsVisible="{Binding HasDiagnosticCode}"
                                   Foreground="{DynamicResource AgentUpColorTextWarningBrush}"/>
                        <TextBlock Text="{Binding ProposalLabel}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ShowProposalBesideTask}"
                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,4,0,0"
                                    IsVisible="{Binding HasStatusRow}">
                            <TextBlock Text="●"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding ChecksToolTip}"
                                       Foreground="{Binding ChecksColor}"/>
                            <TextBlock Text="{Binding ChecksCount}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding ChecksToolTip}"
                                       Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
                            <TextBlock Text="—"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                            <ItemsControl ItemsSource="{Binding Reviews}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="7,2"
                                                CornerRadius="4"
                                                ToolTip.Tip="{Binding ToolTip}"
                                                BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Color}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{Binding ThreadSummary}"
                                   FontSize="11"
                                   IsVisible="{Binding HasUnresolvedThreads}"
                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="3" MinWidth="128">
                        <TextBlock Text="{Binding StateLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Foreground="{Binding StateColor}"/>
                        <TextBlock Text="{Binding Branch}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource AgentUpFontMono}"
                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A queue row: one task, where it stands, and everyone on it. -->
        <DataTemplate x:Key="TaskRowTemplate">
            <Grid ColumnDefinitions="*,150,160"
                  ColumnSpacing="12"
                  Margin="0,0,0,1"
                  Background="{DynamicResource AgentUpColorTransparentBrush}">
                <TextBlock Grid.Column="0"
                           Text="{Binding TaskLabel}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,8"
                           Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StateLabel}"
                           FontSize="12"
                           Margin="0,8"
                           VerticalAlignment="Top"
                           Foreground="{Binding StateColor}"/>
                <ItemsControl Grid.Column="2" Margin="0,8" ItemsSource="{Binding Agents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding RoleLabel}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding HasRole}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="QueuedTaskRowTemplate">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  Margin="0,0,0,1"
                  Background="{DynamicResource AgentUpColorTransparentBrush}">
                <!-- Reorder on the left, because the order is what this list is for. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="0,6" VerticalAlignment="Center">
                    <Button Content="↑"
                            Classes="au-button au-button--compact"
                            Command="{Binding MoveUpCommand}"
                            AutomationProperties.AutomationId="{x:Static ids:DesktopAutomationIds.QueueMoveUp}"
                            ToolTip.Tip="Work this sooner"/>
                    <Button Content="↓"
                            Classes="au-button au-button--compact"
                            Command="{Binding MoveDownCommand}"
                            AutomationProperties.AutomationId="{x:Static ids:DesktopAutomationIds.QueueMoveDown}"
                            ToolTip.Tip="Work this later"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,8" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TaskLabel}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                    <TextBlock Text="{Binding RepositoryLabel}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,6" VerticalAlignment="Center">
                    <Button Content="Dequeue"
                            Classes="au-button au-button--danger au-button--compact"
                            Command="{Binding RemoveCommand}"
                            AutomationProperties.AutomationId="{x:Static ids:DesktopAutomationIds.QueueRemove}"
                            ToolTip.Tip="Take this out of the queue"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A task being worked: no order to change, only whether the work carries on. -->
        <DataTemplate x:Key="WorkingTaskRowTemplate">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  Margin="0,0,0,1"
                  Background="{DynamicResource AgentUpColorTransparentBrush}">
                <StackPanel Grid.Column="0" Margin="0,8" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TaskLabel}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                    <TextBlock Text="{Binding RepositoryLabel}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Stop"
                        Margin="0,6"
                        VerticalAlignment="Center"
                        Classes="au-button au-button--danger au-button--compact"
                        Command="{Binding StopCommand}"
                        AutomationProperties.AutomationId="{x:Static ids:DesktopAutomationIds.QueueStop}"
                        ToolTip.Tip="Stop this work and put the task back in the queue"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OfferedIssueRowTemplate">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  Margin="0,0,0,1"
                  Background="{DynamicResource AgentUpColorTransparentBrush}">
                <TextBlock Grid.Column="0"
                           Text="{Binding IssueLabel}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,8"
                           Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
                <Button Grid.Column="1"
                        Content="Queue"
                        Margin="0,6"
                        VerticalAlignment="Top"
                        Command="{Binding PickCommand}"
                        AutomationProperties.AutomationId="{x:Static ids:DesktopAutomationIds.QueuePick}"
                        ToolTip.Tip="Put this issue in the queue"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="208,*">

        <Border Grid.Column="0"
                Background="{DynamicResource AgentUpColorSurfaceBrush}"
                BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Spacing="2">
                    <TextBlock Text="TEAM"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AgentUpColorTextFaintBrush}"
                               Margin="10,4,0,6"/>
                    <ItemsControl ItemsSource="{Binding CommandCenter.Bridge.Team}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        BorderThickness="0"
                                        Background="{DynamicResource AgentUpColorTransparentBrush}"
                                        Command="{Binding $parent[UserControl].DataContext.CommandCenter.OpenAgentCommand}"
                                        CommandParameter="{Binding Standing}"
                                        AutomationProperties.AutomationId="{x:Static ids:DesktopAutomationIds.TeamOpenAgent}"
                                        ToolTip.Tip="Open this agent's workspace">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding RoleLabel}"
                                                   FontSize="11"
                                                   IsVisible="{Binding HasRole}"
                                                   Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding IdentityHandle}"
                                                   FontSize="11"
                                                   FontFamily="{DynamicResource AgentUpFontMono}"
                                                   ToolTip.Tip="{Binding IdentityToolTip}"
                                                   IsVisible="{Binding HasIdentity}"
                                                   Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                                        <TextBlock Text="{Binding StateLabel}"
                                                   FontSize="11"
                                                   Foreground="{Binding StateColor}"/>
                                        <TextBlock Text="{Binding TaskLabel}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding CommandCenter.Bridge.EmptyTeamHint}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="10,2"
                               IsVisible="{Binding !CommandCenter.Bridge.HasTeam}"
                               Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="6">
                    <Button Command="{Binding CommandCenter.ToggleCommand}"
                            x:Name="SwitchBackButton"
                            AutomationProperties.AutomationId="{x:Static ids:DesktopAutomationIds.CommandCenterSwitchBack}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,8"
                            Background="{DynamicResource AgentUpColorSurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource AgentUpColorBorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="Switch back to the classic interface"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AgentUpColorTextSecondaryBrush}"/>
                    </Button>
                    <TextBlock Text="This machine could not store the choice, so it resets on restart."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="2,0"
                               IsVisible="{Binding !CommandCenter.Persists}"
                               Foreground="{DynamicResource AgentUpColorTextWarningBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="30,26" IsVisible="{Binding CommandCenter.ShowsSurfaces}">
            <StackPanel Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                    <TextBlock Text="Bridge"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AgentUpColorTextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CommandCenter.Bridge.Headline}"
                               FontSize="13"
                               x:Name="BridgeHeadline"
                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                    <TextBlock Text="{Binding CommandCenter.Bridge.ErrorMessage}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding CommandCenter.Bridge.HasError}"
                               Foreground="{DynamicResource AgentUpColorTextDangerBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="WAITING ON YOU"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AgentUpColorTextWarningBrush}"/>
                    <ItemsControl x:Name="WaitingList"
                                  ItemsSource="{Binding CommandCenter.Bridge.WaitingOnYou}"
                                  ItemTemplate="{StaticResource StandingRowTemplate}"/>
                    <TextBlock Text="{Binding CommandCenter.Bridge.EmptyWaitingHint}"
                               FontSize="12"
                               IsVisible="{Binding !CommandCenter.Bridge.HasWaiting}"
                               Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="HALTED"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AgentUpColorTextDangerBrush}"/>
                    <ItemsControl x:Name="HaltedList"
                                  ItemsSource="{Binding CommandCenter.Bridge.Halted}"
                                  ItemTemplate="{StaticResource StandingRowTemplate}"/>
                    <TextBlock Text="{Binding CommandCenter.Bridge.EmptyHaltedHint}"
                               FontSize="12"
                               IsVisible="{Binding !CommandCenter.Bridge.HasHalted}"
                               Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="NOTHING NEEDED"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                    <ItemsControl x:Name="TeamList"
                                  ItemsSource="{Binding CommandCenter.Bridge.NothingNeeded}"
                                  ItemTemplate="{StaticResource StandingRowTemplate}"/>
                    <TextBlock Text="{Binding CommandCenter.Bridge.EmptyNothingNeededHint}"
                               FontSize="12"
                               IsVisible="{Binding !CommandCenter.Bridge.HasNothingNeeded}"
                               Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                </StackPanel>

                <Border Background="{DynamicResource AgentUpColorSurfaceBrush}"
                        BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="TASKS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                        <Grid ColumnDefinitions="*,150,160" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Text="TASK" FontSize="10"
                                       Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                            <TextBlock Grid.Column="1" Text="STATE" FontSize="10"
                                       Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                            <TextBlock Grid.Column="2" Text="ASSIGNED TO" FontSize="10"
                                       Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                        </Grid>
                        <ItemsControl x:Name="TaskList"
                                      ItemsSource="{Binding CommandCenter.Bridge.Tasks}"
                                      ItemTemplate="{StaticResource TaskRowTemplate}"/>
                        <TextBlock Text="No agent reports a task in hand."
                                   FontSize="12"
                                   IsVisible="{Binding !CommandCenter.Bridge.HasTasks}"
                                   Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                        <TextBlock Text="{Binding CommandCenter.Bridge.TasksCaveat}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AgentUpColorSurfaceBrush}"
                        BorderBrush="{DynamicResource AgentUpColorBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        IsVisible="{Binding CommandCenter.Tasks, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="IN PROGRESS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   IsVisible="{Binding CommandCenter.Tasks.HasWorking}"
                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                        <TextBlock Text="Taken off the queue and being worked. Stopping one puts it back."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding CommandCenter.Tasks.HasWorking}"
                                   Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                        <ItemsControl x:Name="WorkingList"
                                      ItemsSource="{Binding CommandCenter.Tasks.Working}"
                                      IsVisible="{Binding CommandCenter.Tasks.HasWorking}"
                                      ItemTemplate="{StaticResource WorkingTaskRowTemplate}"/>

                        <TextBlock Text="QUEUE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                        <TextBlock Text="The agents work these, in this order. Nothing else on the host is touched."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                        <ItemsControl x:Name="QueueList"
                                      ItemsSource="{Binding CommandCenter.Tasks.Queue}"
                                      ItemTemplate="{StaticResource QueuedTaskRowTemplate}"/>
                        <TextBlock Text="{Binding CommandCenter.Tasks.EmptyQueueHint}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !CommandCenter.Tasks.HasQueue}"
                                   Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                        <TextBlock Text="{Binding CommandCenter.Tasks.ErrorMessage}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding CommandCenter.Tasks.HasError}"
                                   Foreground="{DynamicResource AgentUpColorStatusDangerBrush}"/>

                        <TextBlock Text="OPEN ISSUES"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource AgentUpColorTextMutedBrush}"/>
                        <ItemsControl x:Name="OfferedList"
                                      ItemsSource="{Binding CommandCenter.Tasks.Offered}"
                                      ItemTemplate="{StaticResource OfferedIssueRowTemplate}"/>
                        <TextBlock Text="{Binding CommandCenter.Tasks.EmptyOfferedHint}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !CommandCenter.Tasks.HasOffered}"
                                   Foreground="{DynamicResource AgentUpColorTextFaintBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
