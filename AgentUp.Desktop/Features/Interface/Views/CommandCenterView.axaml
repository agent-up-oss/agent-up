<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scene="using:AgentUp.Desktop.DesignSystem"
             x:Class="AgentUp.Desktop.Features.Interface.Views.CommandCenterView"
             x:CompileBindings="False"
             Background="{DynamicResource AgentUpColorCanvasBrush}">
    <!--
        The command center is the generated New UI scene. This host selects that scene and
        fills its slots. It does not draw a second page.
    -->
    <!--
        The New UI styles and press-to-click apply inside the command center only, including the
        classic panes it hosts while it is on screen. The classic shell never sees either.
    -->
    <UserControl.Styles>
        <StyleInclude Source="/DesignSystem/AgentUpNewUiStyles.axaml"/>
        <!-- A press has to run the command. Release clicks ask the compositor which control is
             still under the pointer, and that answer is empty while a hover style is invalidating
             the control, so the click never lands. -->
        <Style Selector="Button">
            <Setter Property="ClickMode" Value="Press"/>
        </Style>
    </UserControl.Styles>
    <scene:NewUiScene x:Name="Scene"/>
</UserControl>
