{
  "name": "agent-up-chat-harness",
  "version": "0.1.0",
  "private": true,
  "description": "The smallest app that can sign an agent in: the chat module, the sign-in module, and nothing else",
  "main": "index.js",
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "export:web": "npx expo export --platform web --output-dir dist",
    "prebuild": "npx expo prebuild --no-install"
  },
  "dependencies": {
    "@agent-up/agent-auth": "file:../AgentUp.AgentAuth",
    "@agent-up/chat": "file:../AgentUp.Chat",
    "@agent-up/design-system": "file:../AgentUp.DesignSystem",
    "@agent-up/server-client": "file:../AgentUp.ServerClient",
    "expo": "~58.0.25",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@config-plugins/detox": "^11.0.0",
    "@types/react": "~19.3.0",
    "detox": "20.42.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.8"
    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-clipboard"
        ]
      }
    }
  }
}
