# @config-plugins/detox still declares a peer range of expo ^53 and this app is on 57, so a plain
# install refuses it. The range is stale metadata rather than a real incompatibility: what the
# plugin generates for this project - the androidTest source set, the Detox instrumentation runner,
# testBuildType, and the maven repository pointing at this project's own copy of Detox - is exactly
# what Detox 20 needs, and it is checked by prebuilding and reading the generated project rather
# than trusted. Without the plugin there is no androidTest APK at all and every Android run dies
# with "Failed to find the app binary".
legacy-peer-deps=true
