{
  "id": "agents",
  "application": "Mobile",
  "name": "See agent availability and start a session",
  "description": "A person opens the Agents tab, creates the workspace's bound agent from the list of agents and whether each is ready, and lands in the conversation with test-agent-scripted. Fixture: isolated Development Server with test-agent-scripted on PATH, listed as Available; the vendor agents are not enabled. Enable is not clicked.",
  "surface": "Mobile",
  "initialPath": "/connect",
  "initialExpectations": [
    { "kind": "Text", "value": "Connect to server" }
  ],
  "steps": [
    {
      "id": "enter-server-url",
      "description": "Enter the Server URL",
      "action": "Fill",
      "target": { "label": "Server URL" },
      "value": "{serverUrl}",
      "expectations": [
        { "kind": "Text", "value": "{serverUrl}", "target": { "label": "Server URL" } }
      ]
    },
    {
      "id": "try-and-save",
      "description": "Save the Server URL and open the workspace",
      "action": "Click",
      "target": { "role": "button", "name": "Try and save" },
      "expectations": [
        { "kind": "Visible", "value": "true", "target": { "role": "tab", "name": "Agents" } }
      ]
    },
    {
      "id": "open-agents",
      "description": "Open the Agents tab",
      "action": "Click",
      "target": { "role": "tab", "name": "Agents" },
      "expectations": [
        { "kind": "Url", "value": "/workspace/{workspaceId}/agents" },
        { "kind": "Visible", "value": "true", "target": { "role": "button", "name": "Create bound agent" } }
      ]
    },
    {
      "id": "choose-agent",
      "description": "Choose which agent the workspace binds",
      "action": "Click",
      "target": { "role": "button", "name": "Create bound agent" },
      "expectations": [
        { "kind": "Url", "value": "/workspace/{workspaceId}/agent-create" },
        { "kind": "Text", "value": "Scripted test agent" },
        { "kind": "Text", "value": "Ready" },
        { "kind": "Text", "value": "Disabled" }
      ]
    },
    {
      "id": "start-scripted",
      "description": "Create the test-agent-scripted agent and open its conversation",
      "action": "Click",
      "target": { "testId": "agent-create-test-agent-scripted" },
      "expectations": [
        { "kind": "Url", "value": "/workspace/{workspaceId}/agent" }
      ]
    }
  ]
}
