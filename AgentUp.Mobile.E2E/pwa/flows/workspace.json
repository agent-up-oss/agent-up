{
  "id": "workspace",
  "application": "Mobile",
  "name": "Workspace list",
  "description": "After connecting, the sidebar lists the registered workspace so the person can switch or add another.",
  "surface": "Mobile",
  "initialPath": "/connect",
  "initialExpectations": [
    {
      "kind": "Text",
      "value": "Connect to server"
    }
  ],
  "steps": [
    {
      "id": "fill-server-url",
      "description": "Enter the Server URL",
      "action": "Fill",
      "target": { "label": "Server URL" },
      "value": "{serverUrl}",
      "expectations": [
        {
          "kind": "Visible",
          "value": "true",
          "target": { "role": "button", "name": "Try and save" }
        }
      ]
    },
    {
      "id": "try-and-save",
      "description": "Try and save the Server URL",
      "action": "Click",
      "target": { "role": "button", "name": "Try and save" },
      "expectations": [
        {
          "kind": "Visible",
          "value": "true",
          "target": { "role": "button", "name": "Open sidebar" }
        }
      ]
    },
    {
      "id": "open-sidebar",
      "description": "Open the workspace sidebar",
      "action": "Click",
      "target": { "role": "button", "name": "Open sidebar" },
      "expectations": [
        {
          "kind": "Visible",
          "value": "true",
          "target": { "role": "button", "name": "Open workspace {workspaceName}" }
        },
        {
          "kind": "Visible",
          "value": "true",
          "target": { "role": "button", "name": "Add workspace" }
        }
      ]
    }
  ]
}
