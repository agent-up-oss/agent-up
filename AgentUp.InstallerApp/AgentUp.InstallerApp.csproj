<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentUp.InstallerApp</RootNamespace>
    <ApplicationIcon>..\media\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>true</IsPackable>
    <PackageId>LocalInstaller.App</PackageId>
    <Version>$(LocalInstallerVersion)</Version>
    <Authors>themassiveone</Authors>
    <Description>Avalonia-based installer GUI and command-line interface built on LocalInstaller.Core.</Description>
    <PackageTags>installer;gui;avalonia;cross-platform;localinstaller</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AgentUp.InstallerApp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentUp.InstallerConfig\AgentUp.InstallerConfig.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\AgentUp.Installers\AgentUp.Installers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Content Include="../media/logo.png" Link="media/logo.png" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

</Project>
