<Project>
  <ItemGroup Condition="Exists('$(AgentUpSdkAgentRoot)AgentUp.Sdk.Agent.csproj')">
    <ProjectReference Include="$(AgentUpSdkAgentRoot)AgentUp.Sdk.Agent.csproj" />
    <ProjectReference Include="$(AgentUpSdkAgentRoot)..\AgentUp.Sdk.Common\AgentUp.Sdk.Common.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(AgentUpSdkAgentRoot)AgentUp.Sdk.Agent.csproj')">
    <Reference Include="AgentUp.Sdk.Agent">
      <HintPath>$(MSBuildThisFileDirectory)..\lib\net10.0\AgentUp.Sdk.Agent.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AgentUp.Sdk.Common">
      <HintPath>$(MSBuildThisFileDirectory)..\lib\net10.0\AgentUp.Sdk.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
</Project>
