{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    "./.github/scripts/generate-release-notes.js",
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "release-artifacts/agent-up-ubuntu-linux-x64.deb",   "label": "Ubuntu (x64) .deb" },
          { "path": "release-artifacts/*.deb.asc",                        "label": "Ubuntu (x64) .deb GPG signature" },
          { "path": "release-artifacts/agent-up-macos-osx-arm64.pkg",    "label": "macOS Apple Silicon .pkg" },
          { "path": "release-artifacts/agent-up-macos-osx-x64.pkg",      "label": "macOS Intel .pkg" },
          { "path": "release-artifacts/agent-up-windows-win-x64.exe",    "label": "Windows (x64) installer" },
          { "path": "release-artifacts/agent-up-windows-win-x64.msi",    "label": "Windows (x64) MSI sidecar" },
          { "path": "release-artifacts/agent-up-nixos-pkgs.tar.gz",      "label": "NixOS packages" },
          { "path": "release-artifacts/agent-up-jetbrains-plugin.zip",   "label": "JetBrains IDE plugin" },
          { "path": "release-artifacts/au-check-linux-x64",          "label": "au-check (linux-x64)" },
          { "path": "release-artifacts/au-check-linux-arm64",        "label": "au-check (linux-arm64)" },
          { "path": "release-artifacts/au-check-osx-arm64",          "label": "au-check (osx-arm64)" },
          { "path": "release-artifacts/au-check-osx-x64",            "label": "au-check (osx-x64)" },
          { "path": "release-artifacts/au-check-win-x64.exe",        "label": "au-check (win-x64)" },
          { "path": "release-artifacts/agent-up-sbom.cdx.json",          "label": "Software Bill of Materials (CycloneDX)" },
          { "path": "release-artifacts/checksums.sha256",                 "label": "SHA-256 checksums" },
          { "path": "release-artifacts/manifest.json",                    "label": "Release manifest" }
        ]
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyConditionsCmd": "./.github/scripts/verify-container.sh AgentUp.Server agent-up-server",
        "publishCmd": "./.github/scripts/build-container.sh AgentUp.Server agent-up-server ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyConditionsCmd": "./.github/scripts/verify-chart.sh",
        "publishCmd": "./.github/scripts/publish-chart.sh ${nextRelease.version}"
      }
    ]
  ]
}
