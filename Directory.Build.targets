<Project>

  <!--
    Normalizes the four LocalInstaller.* NuGet packages after packing so that two pack runs from the same
    source tree produce byte-for-byte identical .nupkg files.  The NuGet SDK embeds a random GUID in the
    PSMDCP filename and writes current-time ZIP entry timestamps — both of which break reproducibility.
    This target replaces both with values derived deterministically from the package identity.
  -->

  <UsingTask TaskName="NormalizeNuGetPackage"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PackagePath ParameterType="System.String" Required="true" />
      <PackageId ParameterType="System.String" Required="true" />
      <PackageVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
        #pragma warning disable CS0162
        if (!File.Exists(PackagePath))
            return true;

        // MS-DOS epoch: smallest timestamp that ZIP can represent.
        var epoch = new DateTimeOffset(1980, 1, 1, 0, 0, 0, TimeSpan.Zero);

        // Derive short hex tokens from a SHA-256 hash so every output value is deterministic.
        static string Hex(string input, int bytes)
        {
            using var sha = SHA256.Create();
            return BitConverter.ToString(
                sha.ComputeHash(Encoding.UTF8.GetBytes(input)), 0, bytes)
                .Replace("-", "");
        }

        var pkg = Path.GetFileNameWithoutExtension(PackagePath); // e.g. LocalInstaller.Core.1.0.0
        var psmdcpName  = Hex("psmdcp:"    + pkg, 16).ToLowerInvariant() + ".psmdcp";
        var psmdcpPath  = "package/services/metadata/core-properties/" + psmdcpName;
        var manifestId  = "R" + Hex("manifest:"  + pkg, 8).ToUpperInvariant();
        var propertiesId = "R" + Hex("properties:" + pkg, 8).ToUpperInvariant();

        // Discover the nuspec filename from the original package.
        string nuspecName;
        using (var probe = ZipFile.OpenRead(PackagePath))
            nuspecName = probe.Entries.First(e => e.Name.EndsWith(".nuspec", StringComparison.Ordinal)).Name;

        // Canonical _rels/.rels with deterministic relationship IDs.
        var relsXml = string.Join("\n", new[]
        {
            "<?xml version=\"1.0\" encoding=\"utf-8\"?>",
            "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">",
            $"  <Relationship Type=\"http://schemas.microsoft.com/packaging/2010/07/manifest\" Target=\"/{nuspecName}\" Id=\"{manifestId}\" />",
            $"  <Relationship Type=\"http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties\" Target=\"/{psmdcpPath}\" Id=\"{propertiesId}\" />",
            "</Relationships>"
        });

        var tempPath = PackagePath + ".normalize-tmp";
        try
        {
            using (var input  = ZipFile.OpenRead(PackagePath))
            using (var output = ZipFile.Open(tempPath, ZipArchiveMode.Create))
            {
                // Stable entry order: ordinal sort by output name.
                foreach (var entry in input.Entries.OrderBy(e => e.FullName, StringComparer.Ordinal))
                {
                    byte[] content;
                    string outName = entry.FullName;

                    if (entry.FullName.EndsWith(".psmdcp", StringComparison.OrdinalIgnoreCase))
                    {
                        outName = psmdcpPath;
                        var psmdcpBody = string.Join("\n", new[]
                        {
                            "<?xml version=\"1.0\" encoding=\"utf-8\"?>",
                            "<coreProperties xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:dcterms=\"http://purl.org/dc/terms/\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns=\"http://schemas.openxmlformats.org/package/2006/metadata/core-properties\">",
                            "  <dc:identifier>" + PackageId + "</dc:identifier>",
                            "  <version>" + PackageVersion + "</version>",
                            "  <lastModifiedBy>agentup-pack</lastModifiedBy>",
                            "</coreProperties>"
                        });
                        content = Encoding.UTF8.GetBytes(psmdcpBody);
                    }
                    else if (entry.FullName == "_rels/.rels")
                    {
                        content = Encoding.UTF8.GetBytes(relsXml);
                    }
                    else
                    {
                        using var s = entry.Open();
                        using var ms = new MemoryStream();
                        s.CopyTo(ms);
                        content = ms.ToArray();
                    }

                    var newEntry = output.CreateEntry(outName, CompressionLevel.Optimal);
                    newEntry.LastWriteTime = epoch;
                    using var writer = newEntry.Open();
                    writer.Write(content, 0, content.Length);
                }
            }

            if (File.Exists(PackagePath)) File.Delete(PackagePath);
            File.Move(tempPath, PackagePath);
        }
        catch
        {
            if (File.Exists(tempPath)) File.Delete(tempPath);
            throw;
        }

        return true;
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="NormalizeLocalInstallerPackage"
          AfterTargets="Pack"
          Condition="'$(IsPackable)' == 'true' AND (
            '$(PackageId)' == 'LocalInstaller.Core'      OR
            '$(PackageId)' == 'LocalInstaller.App'       OR
            '$(PackageId)' == 'LocalInstaller.Smoke'     OR
            '$(PackageId)' == 'LocalInstaller.Packaging'
          )">
    <NormalizeNuGetPackage
      PackagePath="$([System.IO.Path]::Combine('$(PackageOutputAbsolutePath)', '$(PackageId).$(PackageVersion).nupkg'))"
      PackageId="$(PackageId)"
      PackageVersion="$(PackageVersion)" />
  </Target>

</Project>
