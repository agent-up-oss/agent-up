# Agent-Up local development environment
# Copy this file to `.env` in the repository root and adjust values.
# `.env` is gitignored; committed defaults live here.

# REST API administrator password. Uncomment to require Desktop, Mobile, and CLI sign-in.
# AGENTUP_ADMIN_PASSWORD=choose-a-long-password

# Set to true to force REST authentication off even when a password or bearer mode is set.
# AGENTUP_AUTH_DISABLED=true

# Accept a signed bearer token instead of the local administrator password.
# AGENTUP_AUTH_MODE=externalBearer
# AGENTUP_EXTERNAL_ISSUER=https://issuer.example
# AGENTUP_EXTERNAL_AUDIENCE=workspace-environment
# AGENTUP_EXTERNAL_SIGNING_KEY=replace-with-a-32-byte-or-longer-secret
# Alternatively, configure one asymmetric verification source (PEM supports multiline values).
# AGENTUP_EXTERNAL_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AGENTUP_EXTERNAL_JWKS_URI=https://issuer.example/.well-known/jwks.json
# Optional comma-separated allowlist; defaults to HS256, RS256, or ES256 for the selected key source.
# AGENTUP_EXTERNAL_ALGORITHMS=RS256

# Unattended workspace loops stay off until this is true or PUT /api/autonomy
# enables them after a host connection is authorized on at least one workspace.
# AGENTUP_AUTONOMY_ENABLED=true

# MCP is loopback-only by default: a /mcp request from any other address is answered with 404.
# Set this to true to additionally accept MCP from a non-loopback caller. That caller must
# present a valid external bearer token carrying the endpoint's operation permission, so the
# externalBearer settings above are required. Without a token the 404 stays.
# AGENTUP_MCP_REMOTE_ENABLED=true

# Optional connection metadata for GET /api/connection and GET /api/entitlements.
# AGENTUP_CONNECTION_ID=local
# AGENTUP_CONNECTION_DISPLAY_NAME=Agent-Up Server
# AGENTUP_ENTITLEMENT_REVISION=community

# Server listen URL(s). For LAN exposure, terminate TLS in front of the Server
# or bind HTTPS directly. Plain HTTP exposes admin passwords and bearer tokens.
# ASPNETCORE_URLS=http://localhost:5000

# Desktop/CLI server URL when not using the default http://localhost:5000
# AGENTUP_SERVER_URL=http://localhost:5000

# Optional recommended connection. Desktop and Mobile always list this URL first
# and keep it available even when other servers are saved. Leave unset for a
# local-only client. Official binaries set these at build or launch time.
# AGENTUP_RECOMMENDED_SERVER_URL=http://localhost:5288
# AGENTUP_RECOMMENDED_SERVER_NAME=Recommended
# EXPO_PUBLIC_RECOMMENDED_SERVER_URL=http://localhost:5288
# EXPO_PUBLIC_RECOMMENDED_SERVER_NAME=Recommended

# Forgejo OAuth (Server). GitHub uses a per-workspace GitHub App manifest flow
# and does not require a preconfigured client id or client secret.
# AGENTUP_FORGE_CLIENT_ID=
# AGENTUP_FORGE_CLIENT_SECRET=
# Repository launch profile is port 5001; packaged Server is port 5000.
# AGENTUP_FORGE_REDIRECT_URI=http://localhost:5001/api/forge/callback

# GitHub module endpoints. Unset uses github.com. GitHub Enterprise is a URL change.
# AGENTUP_GITHUB_API_URL=https://api.github.com/
# AGENTUP_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# AGENTUP_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token

# Forgejo module. Origin derives /api/v1 and OAuth URLs. Default is a local instance.
# AGENTUP_FORGEJO_ORIGIN=http://localhost:3000
# AGENTUP_FORGEJO_API_URL=
# AGENTUP_FORGEJO_AUTHORIZE_URL=
# AGENTUP_FORGEJO_TOKEN_URL=

# Optional product Sentry DSN. Unset keeps the SDK a no-op.
# SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_DSN=
