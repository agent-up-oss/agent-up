# Agent-Up local development environment
# Copy this file to `.env` in the repository root and adjust values.
# `.env` is gitignored; committed defaults live here.

# REST API administrator password. Desktop and Mobile prompt for this when auth is enabled.
AGENTUP_ADMIN_PASSWORD=choose-a-long-password

# Set to true to disable REST authentication entirely.
# AGENTUP_AUTH_DISABLED=true

# Server listen URL(s). Use 0.0.0.0 to expose REST to your LAN.
# ASPNETCORE_URLS=http://localhost:5000

# Desktop/CLI server URL when not using the default http://localhost:5000
# AGENTUP_SERVER_URL=http://localhost:5000
