<Project>
  <ItemGroup Condition="Exists('$(AgentUpSdkRuntimeRoot)AgentUp.Sdk.Runtime.csproj')">
    <ProjectReference Include="$(AgentUpSdkRuntimeRoot)AgentUp.Sdk.Runtime.csproj" />
    <ProjectReference Include="$(AgentUpSdkRuntimeRoot)..\AgentUp.Sdk.Common\AgentUp.Sdk.Common.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(AgentUpSdkRuntimeRoot)AgentUp.Sdk.Runtime.csproj')">
    <Reference Include="AgentUp.Sdk.Runtime">
      <HintPath>$(MSBuildThisFileDirectory)..\lib\net10.0\AgentUp.Sdk.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AgentUp.Sdk.Common">
      <HintPath>$(MSBuildThisFileDirectory)..\lib\net10.0\AgentUp.Sdk.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
</Project>
