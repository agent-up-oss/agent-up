<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>LocalInstaller.Packaging</PackageId>
    <Version>$(LocalInstallerVersion)</Version>
    <Authors>themassiveone</Authors>
    <Company>LocalInstaller</Company>
    <Description>Build pipeline for producing platform-specific installer packages (Windows MSI, macOS pkg, Ubuntu .deb).</Description>
    <PackageTags>installer;packaging;msi;deb;pkg;windows;macos;linux;localinstaller</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>logo.png</PackageIcon>
    <Copyright>Copyright © 2025 themassiveone</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\media\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalInstaller.Core\LocalInstaller.Core.csproj" />
  </ItemGroup>

</Project>
