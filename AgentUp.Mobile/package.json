{
  "name": "agent-up-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "nix-shell ../shell.nix --run 'expo start --lan'",
    "android": "nix-shell ../shell.nix --run 'expo start --android --lan'",
    "ios": "nix-shell ../shell.nix --run 'expo start --ios --lan'",
    "web": "nix-shell ../shell.nix --run 'expo start --web --lan'",
    "build:web": "nix-shell ../shell.nix --run 'expo export --platform web && workbox generateSW workbox-config.cjs'",
    "typecheck": "nix-shell ../shell.nix --run 'tsc --noEmit'"
  },
  "dependencies": {
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "workbox-cli": "^7.4.1"
  }
}
