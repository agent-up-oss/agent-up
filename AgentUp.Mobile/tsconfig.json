{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../AgentUp.FakeServer/definition.json",
    "../AgentUp.FakeServer/agent-up.css.json"
  ],
  "exclude": [
    "**/*.test.ts",
    "src/features/agents/benchmark/**"
  ]
}
