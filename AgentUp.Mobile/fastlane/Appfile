for_platform :ios do
  app_identifier(ENV.fetch("IOS_BUNDLE_ID", "com.massivecreationlab.agentup"))
end

for_platform :android do
  package_name(ENV.fetch("ANDROID_PACKAGE_NAME", "com.massivecreationlab.agentup"))
  json_key_file(ENV["GOOGLE_PLAY_KEY_FILE_PATH"]) unless ENV["GOOGLE_PLAY_KEY_FILE_PATH"].to_s.strip.empty?
end
