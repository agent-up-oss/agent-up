<Project>
  <ItemGroup Condition="Exists('$(AgentUpSdkForgeRoot)AgentUp.Sdk.Forge.csproj')">
    <ProjectReference Include="$(AgentUpSdkForgeRoot)AgentUp.Sdk.Forge.csproj" />
    <ProjectReference Include="$(AgentUpSdkForgeRoot)..\AgentUp.Sdk.Common\AgentUp.Sdk.Common.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(AgentUpSdkForgeRoot)AgentUp.Sdk.Forge.csproj')">
    <Reference Include="AgentUp.Sdk.Forge">
      <HintPath>$(MSBuildThisFileDirectory)..\lib\net10.0\AgentUp.Sdk.Forge.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AgentUp.Sdk.Common">
      <HintPath>$(MSBuildThisFileDirectory)..\lib\net10.0\AgentUp.Sdk.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
</Project>
