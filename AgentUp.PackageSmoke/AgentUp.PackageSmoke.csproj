<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>LocalInstaller.Smoke</PackageId>
    <Version>$(LocalInstallerVersion)</Version>
    <Authors>themassiveone</Authors>
    <Description>Smoke-test runner for validating freshly installed products on Windows, macOS, Ubuntu, and NixOS.</Description>
    <PackageTags>installer;smoke-test;validation;cross-platform;localinstaller</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentUp.InstallerConfig\AgentUp.InstallerConfig.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\AgentUp.Installers\AgentUp.Installers.csproj" />
  </ItemGroup>

</Project>
