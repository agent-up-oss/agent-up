{
  "name": "Demo Online Shop Agent",
  "display": {
    "name": "agent3",
    "branch": "not a git repo"
  },
  "applications": [
    {
      "name": "Storefront",
      "command": "node storefront/server.mjs",
      "ports": [{ "variable": "STOREFRONT_PORT", "defaultPort": 5300, "protocol": "http" }]
    },
    {
      "name": "AdminPanel",
      "command": "node admin-panel/server.mjs",
      "ports": [{ "variable": "ADMIN_PORT", "defaultPort": 5301, "protocol": "http" }]
    },
    {
      "name": "Payments",
      "command": "node payments/server.mjs",
      "ports": [{ "variable": "PAYMENTS_PORT", "defaultPort": 5302, "protocol": "http" }]
    },
    {
      "name": "Postgres",
      "command": "node postgres/server.mjs",
      "ports": [{ "variable": "DB_PORT", "defaultPort": 5303, "protocol": "http" }]
    }
  ]
}
