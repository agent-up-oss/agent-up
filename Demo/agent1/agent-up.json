{
  "name": "Demo SaaS Login Agent",
  "display": {
    "name": "agent1",
    "branch": "not a git repo"
  },
  "applications": [
    {
      "name": "MarketingSite",
      "command": "node marketing-site/server.mjs",
      "ports": [{ "variable": "WEB_PORT", "defaultPort": 5100, "protocol": "http" }]
    },
    {
      "name": "Dashboard",
      "command": "node dashboard/server.mjs",
      "ports": [{ "variable": "DASHBOARD_PORT", "defaultPort": 5101, "protocol": "http" }]
    },
    {
      "name": "Backend",
      "command": "node backend/server.mjs",
      "ports": [{ "variable": "API_PORT", "defaultPort": 5102, "protocol": "http" }]
    },
    {
      "name": "Postgres",
      "command": "node postgres/server.mjs",
      "ports": [{ "variable": "DB_PORT", "defaultPort": 5103, "protocol": "http" }]
    }
  ]
}
