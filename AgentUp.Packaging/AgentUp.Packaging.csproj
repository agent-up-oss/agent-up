<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>LocalInstaller.Packaging</PackageId>
    <Version>$(LocalInstallerVersion)</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ExcludeAgentUpProductConfiguration)' == 'true'">
    <DefineConstants>$(DefineConstants);EXCLUDE_AGENTUP_PRODUCT_CONFIGURATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentUp.Installers\AgentUp.Installers.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExcludeAgentUpProductConfiguration)' == 'true'">
    <Compile Remove="**/AgentUp*.cs" />
  </ItemGroup>

</Project>
