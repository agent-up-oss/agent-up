<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>LocalInstaller.Packaging</PackageId>
    <Version>$(LocalInstallerVersion)</Version>
    <Authors>themassiveone</Authors>
    <Description>Build pipeline for producing platform-specific installer packages (Windows MSI, macOS pkg, Ubuntu .deb).</Description>
    <PackageTags>installer;packaging;msi;deb;pkg;windows;macos;linux;localinstaller</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentUp.InstallerConfig\AgentUp.InstallerConfig.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\AgentUp.Installers\AgentUp.Installers.csproj" />
  </ItemGroup>

</Project>
