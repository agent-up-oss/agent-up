# This module is consumed as a file: dependency and ships sources, so its own dependencies have to
# be on disk: a bundler reads a module's imports from where the module lives, not from where the
# app does, and without them nothing can resolve @agent-up/* or react-native from in here. That
# includes a copy of react, which would otherwise resolve ahead of the app's and leave every hook
# in this module reading a different dispatcher - so every app that mounts it dedupes the
# singletons in its metro.config.js, and AgentUp.Mobile.E2E/pwa/mounts.spec.mjs fails if that ever
# stops working.
install-strategy=nested
